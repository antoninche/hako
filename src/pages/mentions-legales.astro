---
/**
 * Mentions légales, version provisoire : le texte légal arrive au lot 3.
 * La rubrique « Crédits » est déjà là : les licences des polices et des
 * icônes du site demandent de citer leurs auteurs (src/data/credits.ts).
 */
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { credits, creditsIntro, trademarksNote } from '../data/credits';
import { draftNotice, pages } from '../data/pages';

const { title, description } = pages.legalNotice;
---

<BaseLayout title={title} description={description}>
  <PageIntro title={title}>
    <p class="lead text-muted">{draftNotice}</p>
  </PageIntro>

  <section class="credits" aria-labelledby="credits">
    <div class="container stack">
      <h2 id="credits">Crédits</h2>
      <p>{creditsIntro}</p>
      <ul class="credits__list">
        {credits.map((credit) => (
          <li>
            <strong>{credit.work}</strong>&nbsp;: {credit.author}, licence{' '}
            <a href={credit.license.href}>{credit.license.name}</a>
            {credit.changes ? <>. Modifications&nbsp;: {credit.changes}.</> : '.'}
          </li>
        ))}
      </ul>
      <p class="text-muted">{trademarksNote}</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* L'ouverture de la page laisse déjà un grand espace au-dessus. */
  .credits {
    padding-block-end: var(--space-section);
  }

  .credits__list {
    display: grid;
    gap: var(--space-xs);
    max-width: var(--measure);
  }
</style>
