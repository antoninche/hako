---
/**
 * Page « Notre engagement » : les sept principes de HAKO, chacun avec un
 * paragraphe court et honnête, puis la phrase qui explique le nom.
 * Tous les textes sont dans src/content/engagement.ts.
 */
import PageIntro from '../../components/PageIntro.astro';
import Section from '../../components/Section.astro';
import NameNote from '../../components/engagement/NameNote.astro';
import PrincipleItem from '../../components/engagement/Principle.astro';
import Text from '../../components/texte/Text.astro';
import { engagement } from '../../content/engagement';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { meta, intro, listLabel, principles, next } = engagement;
---

<BaseLayout title={meta.title} description={meta.description}>
  <PageIntro title={intro.title}>
    <p class="lead text-muted">
      <Text text={intro.lead} />
    </p>
  </PageIntro>

  <div class="container">
    <ol class="principles" aria-label={listLabel}>
      {principles.map((principle, index) => (
        <PrincipleItem principle={principle} number={index + 1} />
      ))}
    </ol>
  </div>

  <Section surface="sable" as="div">
    <NameNote />
  </Section>

  <Section labelledby="titre-suite">
    <div class="next">
      <h2 id="titre-suite">{next.title}</h2>
      <ul class="next__links">
        {next.links.map((link) => (
          <li>
            <a class="btn btn--secondary" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---------- Les sept principes ----------
   * Une colonne de lecture alignée sur le titre de la page. L'espace
   * au-dessus vient de l'ouverture (PageIntro). */
  .principles {
    max-inline-size: 52rem;
    margin: 0 0 var(--space-section);
    padding: 0;
    list-style: none;
  }

  /* ---------- Pour aller plus loin ---------- */
  .next {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    text-align: center;
  }

  .next__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
