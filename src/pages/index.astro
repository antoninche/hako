---
/**
 * Accueil. Chaque section est un composant de src/components/accueil/ ;
 * les textes, et la description pour les moteurs de recherche, sont dans
 * src/content/accueil.ts, les prix dans src/data/tarifs.ts.
 * Sans titre, le gabarit affiche « HAKO · Vos souvenirs restent à la maison ».
 */
import BoxScene from '../components/home/BoxScene.astro';
import FinalCall from '../components/accueil/FinalCall.astro';
import Hero from '../components/accueil/Hero.astro';
import Nearby from '../components/accueil/Nearby.astro';
import Offers from '../components/accueil/Offers.astro';
import Problem from '../components/accueil/Problem.astro';
import Steps from '../components/accueil/Steps.astro';
import Trust from '../components/accueil/Trust.astro';
import { keepWordsTogether } from '../components/accueil/no-break';
import BaseLayout from '../layouts/BaseLayout.astro';
import { boxScene, meta } from '../content/accueil';
---

<BaseLayout description={meta.description}>
  <Hero />
  <Problem />
  <BoxScene title={keepWordsTogether(boxScene.title)} intro={keepWordsTogether(boxScene.intro)} />
  <Steps />
  <Offers />
  <Trust />
  <Nearby />
  <FinalCall />
</BaseLayout>
