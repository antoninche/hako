---
/**
 * Bandeau de la démonstration, en haut de la page de la HAKO simulée, au-dessus
 * de chaque écran : « Démonstration : rien n'est envoyé, aucune HAKO n'est
 * installée. », puis, sur une ligne, « Recommencer » (avec JavaScript) et
 * « Revenir au guide », au même dessin de lien d'action. Fond chocolat,
 * comme le pied de page : il ne se confond pas avec la page de la HAKO, sur
 * fond crème. Bas sur téléphone : à chaque changement d'écran, la page
 * défile jusqu'au titre du nouvel écran, juste en dessous.
 * Textes : src/content/assistant.ts, clé demo.banner.
 */
import Icon from '../Icon.astro';
import { assistant } from '../../content/assistant';

const { banner } = assistant.demo;
---

<div class="banner surface-chocolat" data-demo-banner>
  <p class="banner__text">
    <Icon name="info" class="banner__icon" />
    <span>{banner.text}</span>
  </p>
  <div class="banner__actions">
    <button type="button" class="banner__action" data-action="restart" data-js-only hidden>
      {banner.restart}
    </button>
    <a class="banner__action banner__guide" href={banner.guide.href}>
      <Icon name="arrow-left" />
      <span>{banner.guide.label}</span>
    </a>
  </div>
</div>

<style>
  .banner {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-s) clamp(var(--space-s), 3vw, var(--space-l));
    border-start-start-radius: var(--radius);
    border-start-end-radius: var(--radius);
    scroll-margin-top: var(--space-xs);
  }

  .banner__text {
    display: flex;
    gap: var(--space-xs);
    align-items: flex-start;
    max-inline-size: none;
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: var(--tracking-ui);
  }

  .banner__text :global(.banner__icon) {
    margin-block-start: 0.05em;
  }

  .banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    align-items: center;
  }

  /* Les deux actions : liens d'action soulignés, en D-DIN gras. */
  .banner__action {
    display: inline-flex;
    gap: var(--space-2xs);
    align-items: center;
    min-block-size: var(--target-min);
    padding: 0;
    border: 0;
    font-family: var(--font-ui);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    color: var(--link);
    background: none;
    cursor: pointer;
  }

  .banner__action:hover {
    color: var(--link-hover);
    text-decoration-thickness: 2px;
  }

  .banner__action:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  @media (max-width: 29.99rem) {
    .banner__text {
      font-size: var(--step-0);
    }
  }

  @media print {
    .banner {
      display: none;
    }
  }
</style>
