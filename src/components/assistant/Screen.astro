---
/**
 * Un écran de la page de la HAKO (première installation), dans cet ordre :
 * 1. le titre (h2), précédé de « Écran 2 sur 5 » pour les écrans numérotés ;
 *    il reçoit le focus quand l'écran s'affiche (tabindex="-1"), et la page
 *    défile jusqu'à lui ;
 * 2. en démonstration, la note qui dit ce qui change par rapport à la vraie
 *    HAKO, juste sous le titre : on la lit avant le reste ;
 * 3. le chapeau (quoi faire), avec le dessin à côté sur un écran large (à la
 *    même taille que dans le guide) ;
 * 4. le contenu propre à l'écran (contenu passé entre les balises) ;
 * 5. « Ça ne marche pas ? ».
 *
 * La section porte l'ancre de l'écran (#ecran-personnes). Sans JavaScript,
 * les écrans du parcours se lisent l'un sous l'autre ; avec JavaScript, un
 * seul s'affiche à la fois (assistant-ui.ts). Avant que le script démarre,
 * seul l'écran marqué `initial` est montré (règle @media (scripting: enabled)
 * d'Assistant.astro). Les écrans d'attente et d'erreur (`state`) restent
 * cachés sans JavaScript.
 * Textes : src/content/assistant.ts.
 */
import DemoNote from './DemoNote.astro';
import GuideText from '../installation/GuideText.astro';
import Illustration from '../Illustration.astro';
import ScreenProblems from './ScreenProblems.astro';
import type { Problem, Sentence } from '../../content/assistant';
import { fillTemplate } from '../../lib/installation/guide-state.ts';
import { stepNumber, viewAnchor, type ViewId } from '../../lib/assistant/machine.ts';
import { assistant } from '../../content/assistant';

interface Props {
  view: ViewId;
  title: string;
  lead?: readonly Sentence[] | undefined;
  /** Dessin décoratif de src/assets/illustrations/ (le titre et le chapeau disent la même chose). */
  illustration?: { readonly name: string; readonly ratio: '4/3' | '16/10' } | undefined;
  /** En démonstration seulement : ce qui change par rapport à la vraie HAKO. */
  demoNote?: string | undefined;
  demo: boolean;
  problems?: readonly Problem[] | undefined;
  /** Écran montré avant le démarrage du script (l'accueil). */
  initial?: boolean;
  /** Écran d'attente ou d'erreur : caché sans JavaScript. */
  state?: boolean;
}

const {
  view,
  title,
  lead,
  illustration,
  demoNote,
  demo,
  problems,
  initial = false,
  state = false,
} = Astro.props;
const { common } = assistant;
const anchor = viewAnchor(view);
const titleId = `${anchor}-titre`;
const number = stepNumber(view);
const kicker =
  number === null ? null : fillTemplate(common.stepOf, { n: number, total: common.steps.length });
---

<section
  class:list={['screen', { 'screen--state': state }]}
  id={anchor}
  data-screen={view}
  data-active={initial ? '' : undefined}
  aria-labelledby={titleId}
  hidden={state}
>
  <h2 class="screen__title" id={titleId} tabindex="-1">
    {kicker && <span class="screen__kicker">{kicker}</span>} <span>{title}</span>
  </h2>

  {demo && demoNote && <DemoNote text={demoNote} />}

  {(lead || illustration) && (
    <div class:list={['screen__lead', { 'screen__lead--figure': illustration }]}>
      <div class="screen__text">
        {lead?.map((sentence) => (
          <p class="screen__intro">
            <GuideText parts={sentence} />
          </p>
        ))}
        <slot name="lead" />
      </div>
      {illustration && (
        <div class="screen__figure">
          <Illustration name={illustration.name} ratio={illustration.ratio} decorative />
        </div>
      )}
    </div>
  )}

  <slot />

  {problems && problems.length > 0 && <ScreenProblems view={view} problems={problems} />}
</section>

<style>
  /* La section n'a ni marge ni bordure : cachée, elle ne prend aucune place.
     Tout le dessin est porté par ses enfants. */
  .screen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    container: ecran / inline-size;
  }

  /* Sans JavaScript, les écrans du parcours se suivent : un filet fort les
     sépare (« ~ » : un gabarit <template> peut se glisser entre deux écrans).
     Le script marque la page (data-ready) et n'en montre qu'un. */
  :global([data-assistant]:not([data-ready])) .screen ~ .screen {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-2xl);
    border-block-start: var(--rule-width) solid var(--line-strong);
  }

  /* ---------- Titre ---------- */
  .screen__title {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    font-size: var(--step-3);
    scroll-margin-top: var(--space-s);
  }

  .screen__title:focus {
    outline: none;
  }

  .screen__title:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  .screen__kicker {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- Chapeau et dessin ---------- */
  /* Sur un écran étroit, le texte d'abord : la page de la HAKO est un outil,
     ce qu'il faut faire passe avant le dessin. */
  .screen__lead {
    display: grid;
    grid-template-areas:
      'text'
      'figure';
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
  }

  .screen__text {
    display: grid;
    grid-area: text;
    align-content: start;
    gap: var(--space-m);
  }

  .screen__intro {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  /* Mêmes tailles que les dessins du guide (GuideStep.astro). */
  .screen__figure {
    grid-area: figure;
    inline-size: min(100%, 24rem);
  }

  @container ecran (min-width: 50rem) {
    .screen__lead--figure {
      grid-template-areas: 'text figure';
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
      column-gap: var(--space-l);
      align-items: start;
    }

    .screen__figure {
      inline-size: 100%;
    }
  }
</style>
