---
/**
 * Écran « Vos mots de passe » : la HAKO vient de les créer ; une carte par
 * personne (AccountCards.astro), ce qu'il faut savoir sur ces mots de passe,
 * puis « Faire ma fiche de secours ». Après des prénoms modifiés, un encadré
 * au-dessus des cartes dit que ce sont de nouveaux mots de passe, et que la
 * fiche déjà faite ne vaut plus.
 * Textes : src/content/assistant.ts, clé screens.passwords (et demo.passwords).
 */
import AccountCards from './AccountCards.astro';
import DemoNote from './DemoNote.astro';
import GuideNote from '../installation/GuideNote.astro';
import GuideText from '../installation/GuideText.astro';
import Icon from '../Icon.astro';
import Screen from './Screen.astro';
import ScreenNav from './ScreenNav.astro';
import ScreenWhy from './ScreenWhy.astro';
import { assistant } from '../../content/assistant';

interface Props {
  demo: boolean;
}

const { demo } = Astro.props;
const { passwords } = assistant.screens;
---

<Screen
  view="passwords"
  title={passwords.title}
  lead={passwords.lead}
  demoNote={assistant.demo.passwords}
  demo={demo}
  problems={passwords.problems}
>
  <div class="renewed" data-passwords-renewed hidden>
    <GuideNote note={passwords.renewed} />
    {demo && <DemoNote text={assistant.demo.passwordsRenewed} />}
  </div>

  <AccountCards demo={demo} />

  <div class="facts">
    <h3 class="facts__title" id="ecran-mots-de-passe-a-savoir">
      {passwords.facts.title}
    </h3>
    <ul class="facts__list" aria-labelledby="ecran-mots-de-passe-a-savoir">
      {passwords.facts.items.map((item) => (
        <li>
          <GuideText parts={item} />
        </li>
      ))}
    </ul>
  </div>

  {passwords.notes.map((note) => (
    <GuideNote note={note} />
  ))}

  <ScreenWhy why={passwords.why} />

  <ScreenNav>
    <button type="button" class="btn btn--secondary" data-action="go" data-view="people">
      <Icon name="arrow-left" />
      <span>{passwords.back}</span>
    </button>
    <button
      type="button"
      class="btn btn--primary screen-nav__main"
      data-action="go"
      data-view="sheet"
    >
      <span>{passwords.next}</span>
      <Icon name="arrow-right" />
    </button>
  </ScreenNav>
</Screen>

<style>
  .facts {
    display: grid;
    gap: var(--space-s);
  }

  .renewed:not([hidden]) {
    display: grid;
    gap: var(--space-s);
  }

  /* Intertitre, comme ceux du guide. */
  .facts__title {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  .facts__list {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts__list li {
    position: relative;
    max-inline-size: var(--measure);
    padding-inline-start: var(--space-m);
  }

  /* Petite pastille caramel, comme les listes du guide et de la page La box. */
  .facts__list li::before {
    content: '';
    position: absolute;
    inset-block-start: 0.65em;
    inset-inline-start: 0.2rem;
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 50%;
    color: transparent;
    background-color: var(--caramel);
  }
</style>
