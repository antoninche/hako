---
/**
 * Liens vers les réseaux sociaux de HAKO, dans le pied de page (données :
 * src/data/entreprise.ts).
 *
 * Un réseau dont l'adresse est connue devient un lien. Tant qu'elle ne l'est
 * pas, on affiche son icône et son nom sans lien (jamais de lien mort), en
 * couleur plus discrète, et un seul repère jaune après la liste vaut pour
 * tous les réseaux. Chaque adresse reste un todo(…) dans entreprise.ts :
 * TODO.md les liste une par une.
 * Les noms sont en police d'interface (D-DIN gras), comme le plan du site.
 *
 *   <SocialLinks />
 */
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import { company } from '../data/entreprise';
import { isTodo, todo } from '../lib/todo';

const anyMissing = company.social.some((network) => isTodo(network.url));
// Le repère commun, recensé aussi dans TODO.md. Il disparaît de la page dès
// que toutes les adresses sont connues : retirez alors aussi cette ligne.
const missingLinks = todo(
  'Adresses des pages et chaînes de HAKO sur les réseaux sociaux',
  '[liens à venir]',
);
---

<ul class="social-links">
  {company.social.map((network) => (
    <li>
      {isTodo(network.url) ? (
        <span class="social-links__entry social-links__entry--pending">
          <Icon name={network.id} />
          <span class="social-links__name">{network.name}</span>
        </span>
      ) : (
        <a class="social-links__entry social-links__link" href={network.url}>
          <Icon name={network.id} />
          <span class="social-links__name">{network.name}</span>
        </a>
      )}
    </li>
  ))}
</ul>
{anyMissing && (
  <p class="social-links__todo">
    <Todo what={missingLinks.todo}>{missingLinks.placeholder}</Todo>
  </p>
)}

<style>
  .social-links {
    display: grid;
    gap: var(--space-3xs);
  }

  /* Mêmes lettres que le plan du site voisin (D-DIN, taille du texte courant). */
  .social-links__entry {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--target-min);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
  }

  .social-links__entry :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--text-muted);
  }

  /* Pas encore d'adresse : rien à cliquer, le nom se fait plus discret. */
  .social-links__entry--pending {
    color: var(--text-muted);
  }

  /* Le soulignement n'apparaît qu'au survol. */
  .social-links__link {
    color: var(--text);
    text-decoration: none;
  }

  .social-links__link:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .social-links__todo {
    margin-block-start: var(--space-2xs);
  }
</style>
