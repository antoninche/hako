---
/**
 * Liens vers les réseaux sociaux de HAKO (données : src/data/entreprise.ts).
 *
 * Tant que l'adresse d'un réseau est inconnue, on affiche son icône et son
 * nom suivis du texte provisoire surligné, sans lien (jamais de lien mort).
 *
 * Deux dispositions :
 * - column (par défaut) : une liste en colonne, discrète (pied de page) ;
 * - row : les réseaux côte à côte, qui passent à la ligne au besoin, avec
 *   des icônes un peu plus grandes (page Contact).
 * Les noms sont toujours en police d'interface (D-DIN gras).
 *
 *   <SocialLinks />
 *   <SocialLinks layout="row" />
 */
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import { company } from '../data/entreprise';
import { isTodo } from '../lib/todo';

interface Props {
  /** Disposition : en colonne (par défaut) ou en ligne. */
  layout?: 'column' | 'row';
  class?: string;
}

const { layout = 'column', class: className } = Astro.props;
---

<ul class:list={['social-links', `social-links--${layout}`, className]}>
  {company.social.map((network) => (
    <li>
      {isTodo(network.url) ? (
        <span class="social-links__entry">
          <Icon name={network.id} />
          <span class="social-links__name">{network.name}</span>
          <Todo what={network.url.todo}>{network.url.placeholder}</Todo>
        </span>
      ) : (
        <a class="social-links__entry social-links__link" href={network.url}>
          <Icon name={network.id} />
          <span class="social-links__name">{network.name}</span>
        </a>
      )}
    </li>
  ))}
</ul>

<style>
  .social-links {
    display: grid;
    gap: var(--space-3xs);
  }

  /* Mêmes lettres que le plan du site voisin (D-DIN, taille du texte courant). */
  .social-links__entry {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-xs);
    row-gap: var(--space-3xs);
    min-height: var(--target-min);
    font-family: var(--font-ui);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
  }

  .social-links__entry :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--text-muted);
  }

  .social-links__link {
    color: var(--text);
  }

  .social-links__link:hover {
    color: var(--text);
  }

  /* En colonne : le soulignement n'apparaît qu'au survol. */
  .social-links--column .social-links__link {
    text-decoration: none;
  }

  .social-links--column .social-links__link:hover {
    text-decoration: underline;
  }

  /* En ligne : le soulignement des liens du site, invisible jusqu'au survol. */
  .social-links--row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
  }

  .social-links--row .social-links__entry :global(.icon) {
    width: 1.375rem;
    height: 1.375rem;
  }

  .social-links--row .social-links__link {
    text-decoration-color: transparent;
  }

  .social-links--row .social-links__link:hover {
    text-decoration-color: currentColor;
  }
</style>
