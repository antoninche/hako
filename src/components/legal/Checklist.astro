---
/**
 * Liste de constats vérifiés, chaque ligne précédée d'une coche (couleur
 * --success de la surface). S'utilise dans un fichier MDX, autour d'une liste
 * Markdown écrite sur des lignes à part :
 *
 *   <Checklist>
 *
 *   - Il ne dépose aucun cookie.
 *   - Il n’utilise aucun traceur.
 *
 *   </Checklist>
 */
---

<div class="checklist">
  <slot />
</div>

<style>
  /* Classe doublée : l'emporte sur la mise en forme des listes de <Prose>. */
  .checklist.checklist :global(ul) {
    display: grid;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checklist.checklist :global(li) {
    position: relative;
    margin: 0;
    padding-inline-start: 2.25rem;
  }

  /* La coche est dessinée en CSS (deux bordures d'un rectangle pivoté) :
     ni image ni fichier externe. */
  .checklist.checklist :global(li)::before {
    content: '';
    position: absolute;
    inset-block-start: 0.2em;
    inset-inline-start: 0.45rem;
    width: 0.5rem;
    height: 0.95rem;
    border: solid var(--success);
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg);
  }

  .checklist.checklist :global(li)::after {
    content: '';
    position: absolute;
    inset-block-start: 0.05em;
    inset-inline-start: 0;
    width: 1.5rem;
    height: 1.5rem;
    border: var(--rule-width) solid var(--success);
    border-radius: 50%;
  }
</style>
