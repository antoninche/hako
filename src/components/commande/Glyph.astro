---
/**
 * Petites icônes au trait fin des pages Offres et Commander. Toujours
 * décoratives : le texte voisin dit la même chose (aria-hidden).
 *
 *   <Glyph name="check" />
 */
interface Props {
  name: 'check' | 'minus' | 'alert' | 'info' | 'back' | 'next' | 'edit';
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['glyph', className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'check' && <path d="M5 12.5 9.5 17 19 7.5" />}
  {name === 'minus' && <path d="M6.5 12h11" />}
  {name === 'alert' && (
    <>
      <path d="M12 3.5 2.75 19.5h18.5L12 3.5Z" />
      <path d="M12 10v4.25" />
      <path d="M12 16.9v.1" />
    </>
  )}
  {name === 'info' && (
    <>
      <circle cx="12" cy="12" r="8.75" />
      <path d="M12 11v5.5" />
      <path d="M12 7.6v.1" />
    </>
  )}
  {name === 'back' && <path d="M19 12H5.5m5.5-6-6 6 6 6" />}
  {name === 'next' && <path d="M5 12h13.5m-5.5-6 6 6-6 6" />}
  {name === 'edit' && (
    <>
      <path d="M14.5 5.5 18.5 9.5" />
      <path d="M4.5 19.5 5.4 15.6 15.9 5.1a1.9 1.9 0 0 1 2.7 0l.3.3a1.9 1.9 0 0 1 0 2.7L8.4 18.6 4.5 19.5Z" />
    </>
  )}
</svg>

<style>
  .glyph {
    display: inline-block;
    flex: none;
    inline-size: 1.25em;
    block-size: 1.25em;
    vertical-align: -0.25em;
  }
</style>
