---
/**
 * Détail chiffré d'une commande : prix de la box, stockage, paiement unique,
 * abonnement et durée d'engagement (Hako Pro). Tous les montants
 * passent par <Price> : un prix pas encore fixé s'affiche en jaune, jamais
 * comme 0 €. Si le total dépend d'un tel prix, il s'écrit « 1 000 € + [prix] ».
 * L'abonnement s'écrit « 25 € HT par mois » : le statut de TVA suit le montant.
 * L'offre qui ouvrira plus tard (Hako Pro) garde son étiquette « Bientôt ».
 *
 *   <QuoteLines quote={computeQuote(pricing, 'pro', '2to')} />
 */
import Fact from '../Fact.astro';
import SoonBadge from '../SoonBadge.astro';
import Price from './Price.astro';
import { commandePage } from '../../content/commande.ts';
import { missingPrice, proOpening } from '../../data/faits.ts';
import { orMissing } from '../../lib/commande/inline.ts';
import type { Quote } from '../../lib/commande/pricing.ts';

interface Props {
  quote: Quote;
}

const { quote } = Astro.props;
const { offer, storage } = quote;
const labels = commandePage.total;
const offerTax = orMissing(offer.taxStatus, missingPrice.taxStatus(offer));
const subscription = offer.subscription;
---

<dl class="quote" data-quote={`${offer.id}:${storage.id}`}>
  <div class="quote__row">
    <dt>
      {offer.name}
      {offer.id === proOpening.offer && (
        <>
          {' '}
          <SoonBadge label={proOpening.label} />
        </>
      )}
    </dt>
    <dd>
      <Price amount={quote.offerPriceEur} missing={missingPrice.offerPrice(offer)} />
    </dd>
  </div>
  <div class="quote__row">
    <dt>
      {commandePage.recap.storage} {storage.label}
    </dt>
    <dd>
      {quote.storageExtraEur === 0 ? (
        commandePage.storage.included
      ) : (
        <Price
          amount={quote.storageExtraEur}
          missing={missingPrice.storageExtra(storage)}
          sign="plus"
        />
      )}
    </dd>
  </div>
  <div class="quote__row quote__row--total">
    <dt>{labels.oneTime}</dt>
    <dd data-quote-total>
      {quote.oneTimeTotalEur === null ? (
        <>
          <Price amount={quote.oneTimeKnownEur} missing={missingPrice.offerPrice(offer)} />
          {' + '}
          <Price amount={null} missing={missingPrice.storageExtra(storage)} />
        </>
      ) : (
        <Price amount={quote.oneTimeTotalEur} missing={missingPrice.offerPrice(offer)} />
      )}{' '}
      <span class="quote__tax">
        <Fact value={offerTax} />
      </span>
    </dd>
  </div>
  {subscription && quote.monthlyEur !== null && (
    <div class="quote__row">
      <dt>{labels.monthly}</dt>
      <dd data-quote-monthly>
        <Price
          amount={quote.monthlyEur}
          missing={missingPrice.subscriptionPrice(offer)}
          tax={orMissing(subscription.taxStatus, missingPrice.subscriptionTax(offer))}
          per="month"
        />
      </dd>
    </div>
  )}
  {subscription && (
    <div class="quote__row">
      <dt>{labels.commitment}</dt>
      <dd data-quote-commitment>
        <Fact value={orMissing(subscription.commitment, missingPrice.commitment(offer))} />
      </dd>
    </div>
  )}
</dl>

<style>
  .quote {
    display: grid;
    margin: 0;
  }

  .quote__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3xs) var(--space-s);
    padding-block: var(--space-2xs);
    border-block-end: var(--rule-width) solid var(--line);
  }

  .quote__row:last-child {
    border-block-end: 0;
  }

  .quote__row dt {
    color: var(--text-muted);
  }

  .quote__row dd {
    margin: 0 0 0 auto;
    text-align: end;
  }

  .quote__row--total {
    padding-block: var(--space-xs);
    border-block-end-color: var(--line-strong);
  }

  .quote__row--total dt {
    font-family: var(--font-ui);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    color: var(--text);
  }

  .quote__row--total dd {
    font-size: var(--step-1);
  }

  /* Statut de TVA (« HT », « TTC ») : plus petit que le montant, sur chaque ligne. */
  .quote__tax,
  .quote :global(.price__tax) {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
  }
</style>
