---
/**
 * Choix sous forme de carte (bouton radio) du formulaire de commande.
 * Toute la carte est cliquable ; le nom de l'option est l'intitulé du bouton
 * radio, le reste de la carte (contenu passé) en est la description.
 * La propriété badge ajoute une étiquette après le nom (« Bientôt », voir
 * SoonBadge.astro), lue avec lui : « Hako Pro (Bientôt) ».
 *
 *   <Choice name="offre" value="home" id="offre-home" label="Hako Home" checked>
 *     …description…
 *   </Choice>
 */
import SoonBadge from '../SoonBadge.astro';

interface Props {
  name: string;
  value: string;
  id: string;
  label: string;
  checked?: boolean;
  /** Taille du nom : « l » pour les offres, « m » pour le stockage. */
  size?: 'm' | 'l';
  /** Étiquette écrite après le nom, par exemple « Bientôt ». */
  badge?: string | undefined;
}

const { name, value, id, label, checked = false, size = 'm', badge } = Astro.props;
const detailsId = `${id}-details`;
---

<div class:list={['choice', `choice--${size}`]}>
  <input
    class="choice__input"
    type="radio"
    id={id}
    name={name}
    value={value}
    checked={checked}
    aria-describedby={detailsId}
  />
  <label class="choice__label" for={id}>
    {label}
    {badge && (
      <>
        {' '}
        <SoonBadge label={badge} />
      </>
    )}
  </label>
  <div class="choice__details" id={detailsId}>
    <slot />
  </div>
</div>

<style>
  .choice {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-xs);
    row-gap: var(--space-3xs);
    align-items: center;
    align-content: start;
    padding: var(--space-s) var(--space-m) var(--space-m) var(--space-s);
    border: var(--rule-width) solid var(--line-strong);
    border-radius: var(--radius);
    background-color: var(--surface);
    transition:
      border-color var(--dur-1) var(--ease-out),
      box-shadow var(--dur-1) var(--ease-out);
  }

  .choice:hover {
    border-color: var(--text);
  }

  /* Option choisie : bordure plus épaisse ; le rond du bouton radio se remplit aussi. */
  .choice:has(.choice__input:checked) {
    border-color: var(--text);
    box-shadow:
      inset 0 0 0 1px var(--text),
      var(--shadow-m);
  }

  /* Au-dessus de la zone cliquable de l'intitulé, pour rester cliquable lui-même. */
  .choice__input {
    position: relative;
    z-index: 1;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin: 0;
    accent-color: var(--text);
  }

  /* Le cadre de focus entoure toute la carte. */
  @supports selector(:has(*)) {
    .choice__input:focus-visible {
      outline: none;
    }

    .choice:has(.choice__input:focus-visible) {
      outline: var(--focus-width) solid var(--focus);
      outline-offset: var(--focus-offset);
    }
  }

  .choice__label {
    font-family: var(--font-ui);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    line-height: 1.2;
    cursor: pointer;
  }

  /* Toute la carte déclenche le bouton radio. */
  .choice__label::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .choice--l .choice__label {
    font-size: var(--step-2);
  }

  .choice--m .choice__label {
    font-size: var(--step-1);
  }

  .choice__details {
    grid-column: 2;
  }
</style>
