---
/**
 * Une étape du guide d'installation, dans cet ordre :
 * 1. le titre (h2), précédé de « Étape n sur 8 » ;
 * 2. le dessin, la présentation et « Ce qu'il faut faire » (gestes numérotés) ;
 * 3. ce qui est propre à l'étape : chronomètre, choix de l'appareil et lien
 *    vers la page de la HAKO, ce que fait la première installation (puis, après
 *    ses gestes, le même lien vers la page de la HAKO, pour qui lit l'étape 7
 *    avant d'ouvrir la page), ou les applications. À l'étape « page », les encadrés (« Deux mots à
 *    connaître », « Non sécurisé ») viennent avant le choix de l'appareil :
 *    on les lit avant les consignes qui emploient ces mots, et avant le
 *    bouton qui remplace le guide par la page de la HAKO ;
 * 4. les encadrés des autres étapes, puis « Pourquoi cette étape ? » et
 *    « Comment savoir que c'est bon ? » ;
 * 5. les boutons « Étape précédente » et « C'est fait » (avec JavaScript
 *    seulement), puis « Ça ne marche pas ? ».
 *
 * La section porte l'ancre de l'étape (#etape-cable) ; son titre reçoit le
 * focus quand le script du guide l'affiche (tabindex="-1"). Elle n'a pas de
 * nom accessible : une étape cachée (hidden="until-found") deviendrait sinon
 * un repère « région » vide pour les lecteurs d'écran ; le h2 numéroté
 * suffit pour naviguer.
 * Textes : src/content/installation.ts.
 */
import ActionList from './ActionList.astro';
import AppCards from './AppCards.astro';
import Chronometer from './Chronometer.astro';
import DeviceGuides from './DeviceGuides.astro';
import GuideNote from './GuideNote.astro';
import OpenPage from './OpenPage.astro';
import StepProblems from './StepProblems.astro';
import Icon from '../Icon.astro';
import Illustration from '../Illustration.astro';
import GuideText from './GuideText.astro';
import TextLink from '../texte/TextLink.astro';
import { installation, type Step, type StepId } from '../../content/installation';
import { fillTemplate, stepAnchor } from '../../lib/installation/guide-state.ts';

interface Props {
  step: Step;
  /** Rang de l'étape, à partir de 0. */
  index: number;
  /** Nombre d'étapes. */
  total: number;
}

const { step, index, total } = Astro.props;
const { labels } = installation;
const anchor = stepAnchor(step.id);
const titleId = `${anchor}-titre`;
const actionsId = `${anchor}-gestes`;
const isLast = index === total - 1;
/** « Étape 3 sur 8 ». */
const kicker = fillTemplate(labels.stepOf, { n: index + 1, total });

/** Dessin de chaque étape : src/assets/illustrations/installation/<nom>.svg. */
const illustrations = {
  carton: 'carton',
  place: 'emplacement',
  cable: 'cable-reseau',
  alimentation: 'alimentation',
  preparation: 'preparation',
  page: 'page-hako',
  installation: 'fiche-secours',
  applications: 'applications',
} as const satisfies Record<StepId, string>;
---

<section class="step" id={anchor} data-step={step.id}>
  <div class="step__inner">
    <h2 class="step__title" id={titleId} tabindex="-1">
      <span class="step__kicker">{kicker}</span> <span class="step__name">{step.title}</span>
    </h2>

    <div class="step__lead">
      <div class="step__figure">
        <Illustration name={`installation/${illustrations[step.id]}`} ratio="4/3" decorative />
      </div>
      <div class="step__text">
        {step.intro?.map((sentence) => (
          <p class="step__intro">
            <GuideText parts={sentence} />
          </p>
        ))}

        {step.id === 'installation' && (
          <div class="tasks">
            {[step.asks, step.does].map((block, blockIndex) => (
              <div class="tasks__block">
                <h3 class="tasks__title" id={`${anchor}-liste-${blockIndex + 1}`}>
                  {block.title}
                </h3>
                <ul class="tasks__list" aria-labelledby={`${anchor}-liste-${blockIndex + 1}`}>
                  {block.items.map((item) => (
                    <li>
                      <GuideText parts={item} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="tasks__demo">
              <GuideText parts={step.demo} />
            </p>
            <p class="tasks__demo">
              <TextLink link={step.demoLink} arrow />
            </p>
          </div>
        )}

        <h3 class="step__subtitle" id={actionsId}>
          {labels.actions}
        </h3>
        <ActionList items={step.actions} labelledby={actionsId} />

        {step.id === 'installation' && (
          <p class="step__open">
            <a class="btn btn--primary step__open-button" href={step.open.href}>
              <span>{step.open.label}</span>
              <Icon name="arrow-right" />
            </a>
          </p>
        )}
      </div>
    </div>

    {step.id === 'preparation' && <Chronometer chronometer={step.chronometer} />}

    {step.id === 'page' && (
      <>
        {step.notes?.map((note) => (
          <GuideNote note={note} />
        ))}
        <DeviceGuides devices={step.devices} />
        <OpenPage open={step.open} beforeOpen={step.beforeOpen} back={step.back} />
      </>
    )}

    {step.id === 'applications' && <AppCards apps={step.apps} />}

    {step.id !== 'page' && step.notes?.map((note) => <GuideNote note={note} />)}

    <div class="step__facts">
      <div class="fact">
        <h3 class="fact__title">
          <Icon name="info" class="fact__icon" />
          <span>{labels.why}</span>
        </h3>
        {step.why.map((sentence) => (
          <p class="fact__text">
            <GuideText parts={sentence} />
          </p>
        ))}
      </div>
      <div class="fact fact--success">
        <h3 class="fact__title">
          <Icon name="check" class="fact__icon fact__icon--success" />
          <span>{labels.success}</span>
        </h3>
        {step.success.map((sentence) => (
          <p class="fact__text">
            <GuideText parts={sentence} />
          </p>
        ))}
      </div>
    </div>

    {step.id === 'applications' && (
      <p class="step__more">
        <GuideText parts={step.more} />
      </p>
    )}

    {step.nextHint && (
      <p class="step__hint">
        <Icon name="arrow-right" class="step__hint-icon" />
        <span>
          <GuideText parts={step.nextHint} />
        </span>
      </p>
    )}

    <div class="step__nav" data-js-only hidden>
      {index > 0 && (
        <button type="button" class="btn btn--secondary step__previous" data-action="previous">
          <Icon name="arrow-left" />
          <span>{labels.previous}</span>
        </button>
      )}
      <button type="button" class="btn btn--primary step__next" data-action="next">
        <span>{isLast ? labels.finish : labels.next}</span>
        <Icon name={isLast ? 'check' : 'arrow-right'} />
      </button>
    </div>

    <StepProblems
      stepId={step.id}
      problems={step.problems}
      intro={step.problemsIntro}
      filterable={step.id === 'page'}
    />
  </div>
</section>

<style>
  /* La section elle-même n'a ni marge ni bordure : avec JavaScript, une étape
     cachée (hidden="until-found") ne prend alors aucune place. Tout le dessin
     est porté par .step__inner. */
  .step__inner {
    display: grid;
    gap: var(--space-xl);
    container: etape / inline-size;
  }

  /* Toutes les étapes à la suite (sans JavaScript, « Voir toutes les
     étapes », impression) : un filet fort les sépare. */
  :global(.guide[data-mode='all']) .step + .step .step__inner {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-2xl);
    border-block-start: var(--rule-width) solid var(--line-strong);
  }

  /* ---------- Titre ---------- */
  .step__title {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    font-size: var(--step-3);
    /* L'en-tête collant est déjà compté par scroll-padding-top (global.css) :
       ceci ajoute seulement un peu d'air au-dessus du titre. */
    scroll-margin-top: var(--space-s);
  }

  .step__title:focus {
    outline: none;
  }

  .step__title:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  .step__kicker {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- Dessin, présentation et gestes ---------- */
  .step__lead {
    display: grid;
    grid-template-areas:
      'figure'
      'text';
    gap: var(--space-l);
  }

  .step__figure {
    grid-area: figure;
    inline-size: min(100%, 24rem);
  }

  .step__text {
    display: grid;
    grid-area: text;
    align-content: start;
    gap: var(--space-m);
  }

  .step__intro {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .step__subtitle {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  /* Assez de place pour deux colonnes : le dessin passe à droite des gestes,
     jusqu'à 24rem de large, comme sur téléphone. En dessous de 50rem, il
     reste au-dessus du texte, qui garde ainsi des lignes assez longues. */
  @container etape (min-width: 50rem) {
    .step__lead {
      grid-template-areas: 'text figure';
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
      column-gap: var(--space-l);
      align-items: start;
    }

    .step__figure {
      inline-size: 100%;
    }
  }

  /* ---------- Ce que demande et ce que fait la première installation ---------- */
  .tasks {
    display: grid;
    gap: var(--space-s);
  }

  .tasks__block {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-m);
    border: var(--rule-width) solid var(--line);
    border-radius: var(--radius);
  }

  .tasks__title {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-ui);
  }

  .tasks__list {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tasks__list li {
    position: relative;
    padding-inline-start: var(--space-m);
  }

  /* Petite pastille caramel, comme la liste « En bref » de la page La box. */
  .tasks__list li::before {
    content: '';
    position: absolute;
    inset-block-start: 0.65em;
    inset-inline-start: 0.2rem;
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 50%;
    color: transparent;
    background-color: var(--caramel);
  }

  /* Lien vers la démonstration, sous les deux listes : une phrase, puis le
     lien à flèche du site, sur sa propre ligne (comme sur l'accueil). */
  .tasks__demo {
    grid-column: 1 / -1;
    margin: 0;
    max-inline-size: var(--measure);
  }

  /* Le lien vers la page de la HAKO, après les gestes de l'étape 7 : même
     bouton qu'à l'étape 6 (OpenPage), pleine largeur sur téléphone. */
  .step__open {
    margin: 0;
  }

  @media (max-width: 29.99rem) {
    .step__open-button {
      inline-size: 100%;
    }
  }

  .step__open-button > span {
    text-wrap: balance;
  }

  /* ---------- Pourquoi, et comment savoir que c'est bon ---------- */
  .step__facts {
    display: grid;
    gap: var(--space-l) var(--space-xl);
  }

  @container etape (min-width: 40rem) {
    .step__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .fact {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding-block-start: var(--space-m);
    border-block-start: var(--rule-width) solid var(--line-strong);
  }

  .fact__title {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin: 0;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  .fact__title :global(.fact__icon) {
    color: var(--text-muted);
  }

  .fact__title :global(.fact__icon--success) {
    color: var(--success);
  }

  .fact__text,
  .step__more {
    margin: 0;
  }

  /* ---------- Juste avant les boutons ---------- */
  .step__hint {
    display: flex;
    gap: var(--space-xs);
    align-items: flex-start;
    margin: 0;
    padding: var(--space-s) var(--space-m);
    border-inline-start: 3px solid var(--line-strong);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .step__hint :global(.step__hint-icon) {
    margin-block-start: 0.2em;
    color: var(--text-muted);
  }

  /* Sur téléphone, les boutons prennent toute la largeur, l'un sous l'autre,
     dans l'ordre de la page (« Étape précédente » puis « C'est fait ») :
     l'ordre visuel reste celui du clavier. Même dessin que le formulaire de
     commande. Plus large, ils restent côte à côte, à gauche, dans la colonne
     du texte : avec une loupe ou un zoom, on ne cherche pas « C'est fait »
     au bord droit de l'écran. */
  .step__nav {
    display: grid;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
    border-block-start: var(--rule-width) solid var(--line);
  }

  .step__nav .btn {
    inline-size: 100%;
  }

  @media (min-width: 30rem) {
    .step__nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .step__nav .btn {
      inline-size: auto;
      min-inline-size: 9rem;
    }
  }

  /* ---------- Impression : toutes les étapes, sans dessins ni boutons ----------
   * Les blocs se suivent sans grille : break-after n'agit que dans un flux de
   * blocs, et un titre ne reste plus seul en bas d'une page. */
  @media print {
    .step {
      display: block !important;
      content-visibility: visible !important;
    }

    .step + .step .step__inner {
      margin-block-start: var(--space-xl);
      padding-block-start: var(--space-xl);
      border-block-start: var(--rule-width) solid var(--line-strong);
    }

    .step__inner,
    .step__text {
      display: block;
    }

    .step__inner > * + *,
    .step__text > * + * {
      margin-block-start: 1.25rem;
    }

    .step__figure,
    .step__nav,
    .step__hint,
    .step__open {
      display: none !important;
    }

    .step__lead {
      display: block;
    }

    .step__title,
    .step__subtitle,
    .fact__title,
    .tasks__title {
      break-after: avoid;
    }

    /* « Étape 5 sur 8 » et le nom de l'étape restent ensemble. */
    .step__title {
      break-inside: avoid;
    }

    .fact,
    .tasks__block {
      break-inside: avoid;
    }
  }
</style>
