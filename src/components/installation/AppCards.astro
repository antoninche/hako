---
/**
 * Étape « Installez les applications » : une carte par application (Immich,
 * Nextcloud), avec ses liens vers l'App Store et Google Play. Même dessin que
 * les cartes des logiciels de la page La box
 * (src/components/la-box/SoftwareCard.astro). Ce sont de simples liens :
 * rien n'est chargé depuis ces boutiques.
 * Textes : src/content/installation.ts ; adresses : src/data/installation.ts.
 */
import TextLink from '../texte/TextLink.astro';
import type { AppCopy } from '../../content/installation';

interface Props {
  apps: readonly AppCopy[];
}

const { apps } = Astro.props;
---

<ul class="apps">
  {apps.map((app) => (
    <li class="app">
      <div class="app__head">
        <h3 class="app__name" id={`application-${app.id}`}>
          {app.name}
        </h3>
        <p class="app__role">{app.role}</p>
      </div>
      <p class="app__text">{app.text}</p>
      <ul class="app__links" aria-labelledby={`application-${app.id}`}>
        {app.links.map((link) => (
          <li>
            <TextLink link={link} />
          </li>
        ))}
      </ul>
    </li>
  ))}
</ul>

<style>
  .apps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .app {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border: var(--rule-width) solid var(--line);
    border-radius: var(--radius);
    background-color: var(--surface);
    box-shadow: var(--shadow-s);
  }

  .app__head {
    display: grid;
    gap: var(--space-3xs);
  }

  .app__name {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-tight);
  }

  .app__role {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .app__text {
    margin: 0;
  }

  .app__links {
    margin: auto 0 0;
    padding: var(--space-2xs) 0 0;
    list-style: none;
    border-block-start: var(--rule-width) solid var(--line);
  }

  @media print {
    .app {
      box-shadow: none;
      break-inside: avoid;
    }
  }
</style>
