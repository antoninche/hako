---
/**
 * Lien vers une vidéo sur YouTube ou sur PeerTube. Aucune vidéo n'est
 * intégrée dans la page.
 *
 * La carte du tutoriel ne l'affiche que pour une adresse connue : tant
 * qu'elle manque (todo(…) dans src/content/tutoriels.ts), pas de ligne du
 * tout, donc jamais de lien mort (voir videos.ts).
 */
import PeerTubeIcon from '../../assets/icons/social/peertube.svg';
import YouTubeIcon from '../../assets/icons/social/youtube.svg';
import { tutoriels, type Platform } from '../../content/tutoriels';

interface Props {
  platform: Platform;
  url: string;
  /** Titre du tutoriel, ajouté au lien pour les lecteurs d'écran. */
  title: string;
}

const { platform, url, title } = Astro.props;
const { labels } = tutoriels;
const name = labels.platforms[platform];
const Icon = platform === 'youtube' ? YouTubeIcon : PeerTubeIcon;
---

<a class="video" href={url}>
  <span class="video__icon" aria-hidden="true">
    <Icon />
  </span>
  <span class="video__label">
    {labels.watchOn} {name}
    <span class="visually-hidden">&nbsp;: {title}</span>
  </span>
</a>

<style>
  .video {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: var(--target-min);
    padding-inline: var(--space-s);
    border: var(--rule-width) solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    line-height: 1.3;
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease-out),
      box-shadow var(--dur-1) var(--ease-out);
  }

  .video:hover {
    border-color: var(--text);
    box-shadow: inset 0 0 0 var(--rule-width) var(--text);
  }

  .video__icon {
    display: inline-flex;
    flex: none;
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  .video__icon :global(svg) {
    inline-size: 100%;
    block-size: 100%;
  }

  .video__label {
    min-inline-size: 0;
  }
</style>
