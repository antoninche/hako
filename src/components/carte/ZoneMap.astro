---
/**
 * Carte de la zone d’intervention, dessinée en SVG directement dans la page :
 * aucune tuile, aucune requête vers un autre site.
 *
 * - Géométrie (terres) : carte-data.json, produit par `npm run map:build` à
 *   partir de Natural Earth (voir docs/carte.md).
 * - Villes et textes : src/data/zone.ts ; phrase de la légende :
 *   company.serviceArea.sentence (src/data/entreprise.ts).
 * - Style : « papier découpé », comme les illustrations du site
 *   (docs/illustrations.md) ; bords coupés à la main : papier.ts.
 *
 * Une seule carte par page : ses identifiants internes sont fixes.
 */
import { company } from '../../data/entreprise';
import { zoneCities, zoneMapText, type ZoneCity } from '../../data/zone';
import data from './carte-data.json';
import { paperCut, roundedRectPoints, type Point } from './papier';

/** Largeur de la zone autour des villes et entre elles, en kilomètres (indicatif). */
const ZONE_RADIUS_KM = 8;

/** Place du nom de chaque ville par rapport à son repère. */
const LABEL_PLACE: Record<ZoneCity['id'], 'droite' | 'gauche' | 'dessus'> = {
  'salon-de-provence': 'droite',
  'aix-en-provence': 'droite',
  marseille: 'droite',
  toulon: 'dessus',
};

/**
 * Papier découpé, en unités de la carte : les mesures des illustrations
 * (docs/illustrations.md), multipliées par 1,25, car la carte fait 1000 unités
 * de large et les scènes 800.
 * - la feuille de la carte : coins de 44 et coupe de 1,2 dans la série ;
 * - son ombre : décalée de 4 et 6 ;
 * - l’ombre de la zone, posée à plat sur les terres : 2 et 3, comme celle
 *   d’un objet posé au sol (le chat de etape-chez-vous).
 */
const PAPER = {
  card: { x: 2, y: 2, width: 991, height: 738, radius: 55 },
  cardShadow: [5, 7.5],
  zoneShadow: [2.5, 3.75],
  cut: { jitter: 1.5, segment: 75 },
} as const;

/**
 * Repère d’une ville : la goutte terre percée d’un œillet, celle de
 * l’icône « humain proche ». Tracé en pixels d’écran, pointe en (0, 0) ; la
 * feuille de style le met à l’échelle de la carte (--k).
 */
const PIN_PATH =
  'M0 0C-1.6-3.2-6.2-7.4-6.2-11.4A6.2 6.2 0 1 1 6.2-11.4C6.2-7.4 1.6-3.2 0 0ZM0-13.8A2.4 2.4 0 1 0 0-9A2.4 2.4 0 1 0 0-13.8Z';

const { width, height, frame, projection, scaleBar } = data;
const round = (value: number) => Math.round(value * 10) / 10;

/** Projection équirectangulaire, identique à celle du script (scripts/map/). */
const project = (longitude: number, latitude: number): [number, number] => [
  round((longitude - frame.lonMin) * projection.cosLatRef * projection.unitsPerDegreeLat),
  round((frame.latMax - latitude) * projection.unitsPerDegreeLat),
];

/**
 * Décalage du nom par rapport au point de la ville : le nom s’aligne sur la
 * tête du repère en goutte, à 11 px au-dessus de sa pointe.
 */
const labelOffsets = {
  droite: { dx: '0.62em', dy: '-0.4em', anchor: 'start' },
  gauche: { dx: '-0.62em', dy: '-0.4em', anchor: 'end' },
  dessus: { dx: '0', dy: '-1.45em', anchor: 'middle' },
} as const;

const cities = zoneCities.map((city) => {
  const [x, y] = project(city.longitude, city.latitude);
  return { ...city, x, y, label: labelOffsets[LABEL_PLACE[city.id]] };
});

/** Enveloppe convexe (chaîne monotone d’Andrew) des points des villes. */
function convexHull(points: [number, number][]): [number, number][] {
  const sorted = [...points].sort((p, q) => p[0] - q[0] || p[1] - q[1]);
  const cross = (o: [number, number], a: [number, number], b: [number, number]) =>
    (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
  const half = (list: [number, number][]) => {
    const chain: [number, number][] = [];
    for (const p of list) {
      while (
        chain.length >= 2 &&
        cross(chain[chain.length - 2]!, chain[chain.length - 1]!, p) <= 0
      ) {
        chain.pop();
      }
      chain.push(p);
    }
    chain.pop();
    return chain;
  };
  return [...half(sorted), ...half([...sorted].reverse())];
}

/**
 * Contour de la zone : l’enveloppe élargie de `radius` tout autour. Chaque
 * côté est décalé vers l’extérieur, et deux côtés voisins se rejoignent par
 * un arc de cercle centré sur la ville, relevé tous les 22,5° au plus.
 */
function roundedHullPoints(points: [number, number][], radius: number): Point[] {
  if (points.length < 3) {
    throw new Error('La zone demande au moins trois villes non alignées (src/data/zone.ts).');
  }
  const n = points.length;
  const cx = points.reduce((sum, p) => sum + p[0], 0) / n;
  const cy = points.reduce((sum, p) => sum + p[1], 0) / n;
  // Normale extérieure de chaque côté (le côté i va du point i au point i + 1).
  const normals = points.map((p, i): [number, number] => {
    const q = points[(i + 1) % n]!;
    const length = Math.hypot(q[0] - p[0], q[1] - p[1]);
    const nx = (q[1] - p[1]) / length;
    const ny = (p[0] - q[0]) / length;
    const outward = nx * ((p[0] + q[0]) / 2 - cx) + ny * ((p[1] + q[1]) / 2 - cy) > 0;
    return outward ? [nx, ny] : [-nx, -ny];
  });
  return points.flatMap((_, i) => {
    const [x, y] = points[(i + 1) % n]!;
    const [nx, ny] = normals[i]!;
    const [mx, my] = normals[(i + 1) % n]!;
    // Arc qui fait tourner la normale d’un côté vers celle du suivant.
    const start = Math.atan2(ny, nx);
    const turn = Math.atan2(nx * my - ny * mx, nx * mx + ny * my);
    const steps = Math.max(2, Math.ceil(Math.abs(turn) / (Math.PI / 8)));
    return Array.from({ length: steps + 1 }, (_, step): Point => {
      const angle = start + (turn * step) / steps;
      return [x + radius * Math.cos(angle), y + radius * Math.sin(angle), true];
    });
  });
}

// La zone : l’enveloppe des villes élargie de ZONE_RADIUS_KM, limitée aux terres
// à l’affichage, et coupée à la main comme les illustrations.
const hull = convexHull(cities.map((city): [number, number] => [city.x, city.y]));
const zonePath = paperCut(roundedHullPoints(hull, ZONE_RADIUS_KM * projection.unitsPerKm), {
  seed: 'carte-zone',
  ...PAPER.cut,
});

// La feuille de la carte.
const { card } = PAPER;
const cardPath = paperCut(roundedRectPoints(card.x, card.y, card.width, card.height, card.radius), {
  seed: 'carte-fond',
  ...PAPER.cut,
});
const translate = ([dx, dy]: readonly [number, number]) => `translate(${dx} ${dy})`;

// Nom de la mer, au large ; échelle graphique en haut à droite, sur les terres.
const [seaX, seaY] = project(5.37, 42.99);
const scaleEnd = width - 56;
// Espace insécable entre le nombre et l’unité.
const scaleLabel = `${scaleBar.km}\u00a0km`;
const scaleY = 60;

// Dans la phrase de la légende, un nom de ville ne se coupe jamais en fin de ligne.
const cityNames = zoneCities.map((city) => city.name);
const namePattern = new RegExp(`(${cityNames.map((n) => n.replace(/[-.]/g, '\\$&')).join('|')})`);
const sentenceParts = company.serviceArea.sentence
  .split(namePattern)
  .filter((part) => part !== '')
  .map((text) => ({ text, isCity: cityNames.includes(text) }));

const ids = {
  land: 'carte-zone-terres',
  clip: 'carte-zone-decoupe',
  card: 'carte-zone-feuille',
  cardClip: 'carte-zone-feuille-decoupe',
  zone: 'carte-zone-contour',
  pin: 'carte-zone-repere',
  name: 'carte-zone-nom',
  caption: 'carte-zone-legende',
};
const landClip = `url(#${ids.clip})`;
---

<div class="zone-map">
  <figure class="zone-map__figure">
    {/* surface-creme : noms en chocolat et liseré crème, quelle que soit la surface autour. */}
    <div class="zone-map__frame surface-creme">
      <svg
        class="zone-map__svg"
        viewBox={`0 0 ${width} ${height}`}
        role="img"
        aria-labelledby={`${ids.name} ${ids.caption}`}
      >
        <defs>
          <path id={ids.land} d={data.land}></path>
          <path id={ids.zone} d={zonePath}></path>
          <clipPath id={ids.clip}>
            <use href={`#${ids.land}`} clip-rule="evenodd"></use>
          </clipPath>
          <path id={ids.card} d={cardPath}></path>
          <clipPath id={ids.cardClip}>
            <use href={`#${ids.card}`}></use>
          </clipPath>
          <path id={ids.pin} d={PIN_PATH} fill-rule="evenodd"></path>
        </defs>

        <use
          class="card-shadow"
          href={`#${ids.card}`}
          transform={translate(PAPER.cardShadow)}
        ></use>
        <g clip-path={`url(#${ids.cardClip})`}>
          <rect class="sea" width={width} height={height}></rect>
          <g transform={translate(PAPER.zoneShadow)}>
            <use
              class="zone-shadow zone-shadow--sea"
              href={`#${ids.zone}`}
              clip-path={landClip}
            ></use>
          </g>
          <use class="land" href={`#${ids.land}`} fill-rule="evenodd"></use>
          <g clip-path={landClip}>
            <g transform={translate(PAPER.zoneShadow)}>
              <use
                class="zone-shadow zone-shadow--land"
                href={`#${ids.zone}`}
                clip-path={landClip}
              ></use>
            </g>
          </g>
          <use class="zone" href={`#${ids.zone}`} clip-path={landClip}></use>

          <text class="sea-label" x={seaX} y={seaY} text-anchor="middle">
            {zoneMapText.sea}
          </text>

          <g class="scale">
            <path d={`M${round(scaleEnd - scaleBar.length)} ${scaleY}H${scaleEnd}`}></path>
            <text
              x={round(scaleEnd - scaleBar.length)}
              y={scaleY}
              dx="-0.5em"
              dy="0.35em"
              text-anchor="end"
            >
              {scaleLabel}
            </text>
          </g>

          <g class="cities">
            {cities.map((city) => (
              <g transform={`translate(${city.x} ${city.y})`}>
                <g class="pin">
                  <use class="pin-shadow" href={`#${ids.pin}`}></use>
                  <use class="pin-face" href={`#${ids.pin}`}></use>
                </g>
              </g>
            ))}
          </g>
          <g class="city-labels">
            {cities.map((city) => (
              <text
                x={city.x}
                y={city.y}
                dx={city.label.dx}
                dy={city.label.dy}
                text-anchor={city.label.anchor}
              >
                {city.name}
              </text>
            ))}
          </g>
        </g>
      </svg>
    </div>
    <figcaption class="zone-map__caption">
      <span class="visually-hidden" id={ids.name}>
        {zoneMapText.mapName}
      </span>
      <span id={ids.caption}>
        {sentenceParts.map((part) =>
          part.isCity ? <span class="zone-map__nowrap">{part.text}</span> : part.text,
        )}
      </span>
    </figcaption>
  </figure>

  <div class="zone-map__legend">
    <ol class="zone-map__cities" aria-label={zoneMapText.citiesHeading}>
      {cities.map((city) => (
        <li>
          <svg
            class="zone-map__key zone-map__key--pin"
            viewBox="-7 -18.5 15 20.5"
            aria-hidden="true"
            focusable="false"
          >
            <use class="pin-shadow" href={`#${ids.pin}`}></use>
            <use class="pin-face" href={`#${ids.pin}`}></use>
          </svg>
          {city.name}
        </li>
      ))}
    </ol>
    <p class="zone-map__note">
      <span class="zone-map__key zone-map__key--zone" aria-hidden="true"></span>
      {zoneMapText.note}
    </p>
    <p class="zone-map__credit">{zoneMapText.credit}</p>
  </div>
</div>

<style>
  /*
   * Couleurs de la carte : uniquement des jetons de la palette, sans dégradé,
   * sans filtre ni transparence, partagées par la carte et sa légende.
   *
   * Papier découpé, selon les règles des illustrations du site
   * (docs/illustrations.md) : des feuilles plates sans contour ; la
   * profondeur vient d’une ombre plate décalée vers le bas à droite, du ton
   * plus sombre que le papier sur lequel elle tombe (crème ou sable → lin,
   * lin → caramel).
   * - la feuille de la carte, sable comme la carte de chaque scène, porte les
   *   terres ; son ombre lin tombe sur la page ;
   * - la mer, une feuille lin, comme le sol des scènes ;
   * - la zone, une pièce crème (la lumière) posée sur les terres ;
   * - les villes, la goutte terre de l’icône « humain proche ».
   */
  .zone-map {
    --carte-mer: var(--lin);
    --carte-terre: var(--sable);
    --carte-zone: var(--creme);
    --carte-ombre-page: var(--lin);
    --carte-ombre-terre: var(--lin);
    --carte-ombre-mer: var(--caramel);
    --carte-repere: var(--terre);
  }

  /* Sur fond chocolat, aucune ombre plus sombre que le fond : la feuille n’en a pas. */
  :global(.surface-chocolat) .zone-map {
    --carte-ombre-page: var(--chocolat);
  }

  .zone-map__figure {
    margin: 0;
  }

  /* La feuille est dessinée dans le SVG ; le cadre ne fait que la porter. */
  .zone-map__frame {
    container-type: inline-size;
    background-color: transparent;
  }

  /*
   * Les tailles du texte, des repères et du trait de l’échelle sont données
   * en pixels à l’écran : --k convertit un pixel affiché en unités de la
   * carte. La carte fait 1000 unités de large, donc --k vaut 1000 divisé par
   * la largeur la plus petite de chaque palier : le texte ne descend jamais
   * sous sa taille prévue et la dépasse au plus d’un cinquième. Les ombres et
   * les coins du papier, eux, suivent la carte, comme dans les illustrations.
   */
  .zone-map__svg {
    --k: 3.57;
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  @container (min-width: 20rem) {
    .zone-map__svg {
      --k: 3.125;
    }
  }

  @container (min-width: 22.5rem) {
    .zone-map__svg {
      --k: 2.78;
    }
  }

  @container (min-width: 25rem) {
    .zone-map__svg {
      --k: 2.5;
    }
  }

  @container (min-width: 28.75rem) {
    .zone-map__svg {
      --k: 2.17;
    }
  }

  @container (min-width: 33.75rem) {
    .zone-map__svg {
      --k: 1.85;
    }
  }

  @container (min-width: 40rem) {
    .zone-map__svg {
      --k: 1.56;
    }
  }

  @container (min-width: 47.5rem) {
    .zone-map__svg {
      --k: 1.32;
    }
  }

  @container (min-width: 56.25rem) {
    .zone-map__svg {
      --k: 1.11;
    }
  }

  @container (min-width: 66.25rem) {
    .zone-map__svg {
      --k: 0.94;
    }
  }

  .card-shadow {
    fill: var(--carte-ombre-page);
  }

  .sea {
    fill: var(--carte-mer);
  }

  .land {
    fill: var(--carte-terre);
  }

  .zone {
    fill: var(--carte-zone);
  }

  .zone-shadow--sea {
    fill: var(--carte-ombre-mer);
  }

  .zone-shadow--land {
    fill: var(--carte-ombre-terre);
  }

  /* Repères : la goutte reste à taille fixe à l’écran, son ombre aussi. */
  .pin {
    transform: scale(var(--k));
  }

  .pin-face {
    fill: var(--carte-repere);
  }

  .pin-shadow {
    fill: var(--carte-ombre-terre);
    transform: translate(1px, 1.5px);
  }

  /* Noms : vrai texte, avec un liseré crème pour rester lisible sur tous les papiers. */
  .zone-map__svg text {
    fill: var(--text);
    stroke: var(--surface);
    stroke-linejoin: round;
    paint-order: stroke;
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .city-labels text {
    font-size: calc(0.9375rem * var(--k));
    letter-spacing: var(--tracking-ui);
    stroke-width: calc(0.25rem * var(--k));
  }

  .sea-label,
  .scale text {
    fill: var(--text-muted);
    font-size: calc(0.75rem * var(--k));
    stroke-width: calc(0.2rem * var(--k));
  }

  /* En pleine mer, le liseré prend la couleur de la mer : il ne se voit pas. */
  .sea-label {
    stroke: var(--carte-mer);
    text-transform: uppercase;
    letter-spacing: 0.25em;
  }

  /* Échelle : un petit lien noyer aux bouts ronds, comme les ficelles de la série. */
  .scale path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: calc(0.125rem * var(--k));
    stroke-linecap: round;
  }

  .zone-map__caption {
    margin-block-start: var(--space-s);
    max-inline-size: var(--measure);
  }

  .zone-map__nowrap,
  .zone-map__cities li {
    white-space: nowrap;
  }

  .zone-map__legend {
    margin-block-start: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .zone-map__cities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    color: var(--text);
  }

  /* Pastilles posées sur la ligne de base : alignées sur la première ligne du texte. */
  .zone-map__cities li,
  .zone-map__note {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .zone-map__note,
  .zone-map__credit {
    margin-block: var(--space-2xs) 0;
  }

  .zone-map__key {
    flex: none;
    display: inline-block;
  }

  /* Repère de la légende : la même goutte, sa pointe sur la ligne de base. */
  .zone-map__key--pin {
    inline-size: 0.7rem;
    block-size: 0.95rem;
    overflow: visible;
  }

  /* Son ombre tombe sur la page : lin sur crème ou sable, aucune sur chocolat. */
  .zone-map__key--pin .pin-shadow {
    fill: var(--carte-ombre-page);
  }

  /* Sur fond chocolat, un liseré crème détache la goutte terre. */
  :global(.surface-chocolat) .zone-map__key--pin .pin-face {
    stroke: var(--creme);
    stroke-width: 1.5px;
    paint-order: stroke;
  }

  /*
   * Pastille de la zone : un petit morceau de la carte, la bande crème de la
   * zone en travers de sa feuille sable, chacune avec son ombre. Formes sans
   * texte : aucune couleur de texte à contrôler (npm run contrast).
   */
  .zone-map__key--zone {
    position: relative;
    overflow: hidden;
    inline-size: 1.5rem;
    block-size: 1rem;
    border-radius: 0.25rem;
    color: transparent;
    background-color: var(--carte-terre);
    box-shadow: 0.0625rem 0.09rem 0 var(--carte-ombre-page);
  }

  .zone-map__key--zone::after {
    content: '';
    position: absolute;
    inset: 0.25rem -0.25rem auto;
    block-size: 0.45rem;
    border-radius: 0.225rem;
    color: transparent;
    background-color: var(--carte-zone);
    box-shadow: 0.04rem 0.06rem 0 var(--carte-ombre-terre);
    transform: rotate(32deg);
  }
</style>
