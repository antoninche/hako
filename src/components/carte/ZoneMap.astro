---
/**
 * Carte de la zone d’intervention, dessinée en SVG directement dans la page :
 * aucune tuile, aucune requête vers un autre site.
 *
 * - Géométrie (terres, lignes d’eau) : carte-data.json, produit par
 *   `npm run map:build` à partir de Natural Earth (voir docs/carte.md).
 * - Villes et textes : src/data/zone.ts ; phrase de la légende :
 *   company.serviceArea.sentence (src/data/entreprise.ts).
 * - Style : la constante PRESET ci-dessous.
 *
 * Une seule carte par page : ses identifiants internes sont fixes.
 */
import { company } from '../../data/entreprise';
import { zoneCities, zoneMapText, type ZoneCity } from '../../data/zone';
import data from './carte-data.json';

/**
 * Style de la carte, calqué sur les trois pistes des illustrations :
 * 'a' trait d’encre fin, 'b' aplats chauds, 'c' papier découpé.
 * À aligner sur la série choisie par le jury des illustrations.
 */
const PRESET: 'a' | 'b' | 'c' = 'a';

/** Largeur de la zone autour des villes et entre elles, en kilomètres (indicatif). */
const ZONE_RADIUS_KM = 8;

/** Place du nom de chaque ville par rapport à son point. */
const LABEL_PLACE: Record<ZoneCity['id'], 'droite' | 'gauche' | 'dessus'> = {
  'salon-de-provence': 'droite',
  'aix-en-provence': 'droite',
  marseille: 'droite',
  toulon: 'dessus',
};

const { width, height, frame, projection, scaleBar } = data;
const round = (value: number) => Math.round(value * 10) / 10;

/** Projection équirectangulaire, identique à celle du script (scripts/map/). */
const project = (longitude: number, latitude: number): [number, number] => [
  round((longitude - frame.lonMin) * projection.cosLatRef * projection.unitsPerDegreeLat),
  round((frame.latMax - latitude) * projection.unitsPerDegreeLat),
];

const labelOffsets = {
  droite: { dx: '0.6em', dy: '0.35em', anchor: 'start' },
  gauche: { dx: '-0.6em', dy: '0.35em', anchor: 'end' },
  dessus: { dx: '0', dy: '-0.75em', anchor: 'middle' },
} as const;

const cities = zoneCities.map((city) => {
  const [x, y] = project(city.longitude, city.latitude);
  return { ...city, x, y, label: labelOffsets[LABEL_PLACE[city.id]] };
});

/** Enveloppe convexe (chaîne monotone d’Andrew) des points des villes. */
function convexHull(points: [number, number][]): [number, number][] {
  const sorted = [...points].sort((p, q) => p[0] - q[0] || p[1] - q[1]);
  const cross = (o: [number, number], a: [number, number], b: [number, number]) =>
    (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
  const half = (list: [number, number][]) => {
    const chain: [number, number][] = [];
    for (const p of list) {
      while (
        chain.length >= 2 &&
        cross(chain[chain.length - 2]!, chain[chain.length - 1]!, p) <= 0
      ) {
        chain.pop();
      }
      chain.push(p);
    }
    chain.pop();
    return chain;
  };
  return [...half(sorted), ...half([...sorted].reverse())];
}

/**
 * Contour de la zone : l’enveloppe élargie de `radius` tout autour. Chaque
 * côté est décalé vers l’extérieur, et deux côtés voisins se rejoignent par
 * un arc de cercle centré sur la ville.
 */
function roundedHullPath(points: [number, number][], radius: number): string {
  if (points.length < 3) {
    throw new Error('La zone demande au moins trois villes non alignées (src/data/zone.ts).');
  }
  const n = points.length;
  const cx = points.reduce((sum, p) => sum + p[0], 0) / n;
  const cy = points.reduce((sum, p) => sum + p[1], 0) / n;
  // Normale extérieure de chaque côté (le côté i va du point i au point i + 1).
  const normals = points.map((p, i): [number, number] => {
    const q = points[(i + 1) % n]!;
    const length = Math.hypot(q[0] - p[0], q[1] - p[1]);
    const nx = (q[1] - p[1]) / length;
    const ny = (p[0] - q[0]) / length;
    const outward = nx * ((p[0] + q[0]) / 2 - cx) + ny * ((p[1] + q[1]) / 2 - cy) > 0;
    return outward ? [nx, ny] : [-nx, -ny];
  });
  const at = (p: [number, number], [nx, ny]: [number, number]) =>
    `${round(p[0] + radius * nx)} ${round(p[1] + radius * ny)}`;
  let path = `M${at(points[0]!, normals[0]!)}`;
  for (let i = 0; i < n; i++) {
    const corner = points[(i + 1) % n]!;
    const normal = normals[i]!;
    const next = normals[(i + 1) % n]!;
    // Sens de l’arc : celui qui fait tourner la normale d’un côté vers celle du suivant.
    const sweep = normal[0] * next[1] - normal[1] * next[0] > 0 ? 1 : 0;
    path += `L${at(corner, normal)}A${round(radius)} ${round(radius)} 0 0 ${sweep} ${at(corner, next)}`;
  }
  return `${path}Z`;
}

// La zone : l’enveloppe des villes élargie de ZONE_RADIUS_KM, limitée aux terres.
const hull = convexHull(cities.map((city): [number, number] => [city.x, city.y]));
const zonePath = roundedHullPath(hull, ZONE_RADIUS_KM * projection.unitsPerKm);

// Nom de la mer, au large ; échelle graphique en haut à droite, sur les terres.
const [seaX, seaY] = project(5.37, 42.99);
const scaleEnd = width - 28;
// Espace insécable entre le nombre et l’unité.
const scaleLabel = `${scaleBar.km}\u00a0km`;
const scaleY = 48;

// Dans la phrase de la légende, un nom de ville ne se coupe jamais en fin de ligne.
const cityNames = zoneCities.map((city) => city.name);
const namePattern = new RegExp(`(${cityNames.map((n) => n.replace(/[-.]/g, '\\$&')).join('|')})`);
const sentenceParts = company.serviceArea.sentence
  .split(namePattern)
  .filter((part) => part !== '')
  .map((text) => ({ text, isCity: cityNames.includes(text) }));

const ids = {
  land: 'carte-zone-terres',
  clip: 'carte-zone-decoupe',
  name: 'carte-zone-nom',
  caption: 'carte-zone-legende',
};
---

<div class="zone-map" data-preset={PRESET}>
  <figure class="zone-map__figure">
    <div class="zone-map__frame surface-creme">
      <svg
        class="zone-map__svg"
        viewBox={`0 0 ${width} ${height}`}
        role="img"
        aria-labelledby={`${ids.name} ${ids.caption}`}
      >
        <defs>
          <path id={ids.land} d={data.land}></path>
          <clipPath id={ids.clip}>
            <use href={`#${ids.land}`} clip-rule="evenodd"></use>
          </clipPath>
        </defs>

        <rect class="sea" width={width} height={height}></rect>
        <g class="water" fill-rule="evenodd">
          {data.water.map((level) => (
            <path d={level.path} />
          ))}
        </g>
        <use class="land-shadow" href={`#${ids.land}`} fill-rule="evenodd"></use>
        <use class="land" href={`#${ids.land}`} fill-rule="evenodd"></use>
        <g clip-path={`url(#${ids.clip})`}>
          <path class="zone-shadow" d={zonePath}></path>
          <path class="zone" d={zonePath}></path>
        </g>
        <use class="coast" href={`#${ids.land}`}></use>

        <text class="sea-label" x={seaX} y={seaY} text-anchor="middle">
          {zoneMapText.sea}
        </text>

        <g class="scale">
          <path d={`M${round(scaleEnd - scaleBar.length)} ${scaleY}H${scaleEnd}`}></path>
          <text
            x={round(scaleEnd - scaleBar.length)}
            y={scaleY}
            dx="-0.5em"
            dy="0.35em"
            text-anchor="end"
          >
            {scaleLabel}
          </text>
        </g>

        <g class="cities">
          {cities.map((city) => (
            <circle cx={city.x} cy={city.y} r="10" />
          ))}
        </g>
        <g class="city-labels">
          {cities.map((city) => (
            <text
              x={city.x}
              y={city.y}
              dx={city.label.dx}
              dy={city.label.dy}
              text-anchor={city.label.anchor}
            >
              {city.name}
            </text>
          ))}
        </g>
      </svg>
    </div>
    <figcaption class="zone-map__caption">
      <span class="visually-hidden" id={ids.name}>
        {zoneMapText.mapName}
      </span>
      <span id={ids.caption}>
        {sentenceParts.map((part) =>
          part.isCity ? <span class="zone-map__nowrap">{part.text}</span> : part.text,
        )}
      </span>
    </figcaption>
  </figure>

  <div class="zone-map__legend">
    <ol class="zone-map__cities" aria-label={zoneMapText.citiesHeading}>
      {cities.map((city) => (
        <li>
          <span class="zone-map__key zone-map__key--city" aria-hidden="true" />
          {city.name}
        </li>
      ))}
    </ol>
    <p class="zone-map__note">
      <span class="zone-map__key zone-map__key--zone" aria-hidden="true"></span>
      {zoneMapText.note}
    </p>
    <p class="zone-map__credit">{zoneMapText.credit}</p>
  </div>
</div>

<style>
  /*
   * Couleurs de la carte : uniquement des jetons de la palette, sans dégradé,
   * sans filtre ni transparence. Chaque style redéfinit ces variables,
   * partagées par la carte et sa légende ; le dessin reste le même.
   * Valeurs par défaut : style A, trait d’encre fin (tout au trait ; la zone,
   * seul aplat, a un bord en tirets).
   */
  .zone-map {
    --carte-mer: var(--creme);
    --carte-eau-loin: var(--noyer);
    --carte-eau-milieu: var(--noyer);
    --carte-eau-pres: var(--noyer);
    --carte-terre: var(--creme);
    --carte-ombre: var(--noyer);
    --carte-cote: var(--chocolat);
    --carte-zone: var(--sable);
    --carte-zone-bord: var(--caramel);
    --carte-point: var(--chocolat);
    --carte-point-bord: var(--creme);
    /* Épaisseurs en pixels à l’écran (multipliées par --k plus bas). */
    --carte-trait-cote: 0.08rem;
    --carte-trait-eau: 0.04rem;
    --carte-trait-zone: 0.09rem;
  }

  /* B, aplats chauds : mer et terres en aplats, cernés d’un trait fin. */
  .zone-map[data-preset='b'] {
    --carte-mer: var(--lin);
    --carte-eau-loin: var(--sable);
    --carte-eau-milieu: var(--creme);
    --carte-eau-pres: var(--creme);
    --carte-cote: var(--noyer);
    --carte-trait-cote: 0.0625rem;
    --carte-trait-eau: 0.075rem;
    --carte-trait-zone: 0.0625rem;
  }

  /* C, papier découpé : feuilles superposées, chacune décalée de son ombre. */
  .zone-map[data-preset='c'] {
    --carte-mer: var(--lin);
    --carte-eau-loin: var(--sable);
    --carte-eau-milieu: var(--sable);
    --carte-eau-pres: var(--sable);
    --carte-ombre: var(--caramel);
    --carte-zone: var(--sable);
    --carte-zone-bord: var(--caramel);
  }

  .zone-map__figure {
    margin: 0;
  }

  .zone-map__frame {
    container-type: inline-size;
    overflow: hidden;
    border: var(--rule-width) solid var(--line);
    border-radius: var(--radius);
  }

  /*
   * Les tailles du texte et des traits sont données en pixels à l’écran :
   * --k convertit un pixel affiché en unités de la carte. La carte fait
   * 1000 unités de large, donc --k vaut 1000 divisé par la largeur la plus
   * petite de chaque palier : le texte ne descend jamais sous sa taille
   * prévue et la dépasse au plus d’un cinquième.
   */
  .zone-map__svg {
    --k: 3.57;
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  @container (min-width: 20rem) {
    .zone-map__svg {
      --k: 3.125;
    }
  }

  @container (min-width: 22.5rem) {
    .zone-map__svg {
      --k: 2.78;
    }
  }

  @container (min-width: 25rem) {
    .zone-map__svg {
      --k: 2.5;
    }
  }

  @container (min-width: 28.75rem) {
    .zone-map__svg {
      --k: 2.17;
    }
  }

  @container (min-width: 33.75rem) {
    .zone-map__svg {
      --k: 1.85;
    }
  }

  @container (min-width: 40rem) {
    .zone-map__svg {
      --k: 1.56;
    }
  }

  @container (min-width: 47.5rem) {
    .zone-map__svg {
      --k: 1.32;
    }
  }

  @container (min-width: 56.25rem) {
    .zone-map__svg {
      --k: 1.11;
    }
  }

  @container (min-width: 66.25rem) {
    .zone-map__svg {
      --k: 0.94;
    }
  }

  .sea {
    fill: var(--carte-mer);
  }

  .water path {
    fill: none;
    stroke-width: calc(var(--carte-trait-eau) * var(--k));
    stroke-linejoin: round;
  }

  .water path:nth-child(1) {
    stroke: var(--carte-eau-loin);
  }

  .water path:nth-child(2) {
    stroke: var(--carte-eau-milieu);
  }

  .water path:nth-child(3) {
    stroke: var(--carte-eau-pres);
    display: none;
  }

  /* La ligne la plus proche de la côte n’apparaît que sur une carte assez large. */
  @container (min-width: 33.75rem) {
    .water path:nth-child(3) {
      display: inline;
    }
  }

  .land {
    fill: var(--carte-terre);
  }

  .land-shadow,
  .zone-shadow {
    display: none;
  }

  .zone {
    fill: var(--carte-zone);
    stroke: var(--carte-zone-bord);
    stroke-width: calc(var(--carte-trait-zone) * var(--k));
    stroke-linecap: round;
  }

  /* Tirets : la limite de la zone n’est pas exacte. */
  .zone-map[data-preset='a'] .zone {
    stroke-dasharray: calc(0.3rem * var(--k)) calc(0.3rem * var(--k));
  }

  .coast {
    fill: none;
    stroke: var(--carte-cote);
    stroke-width: calc(var(--carte-trait-cote) * var(--k));
    stroke-linejoin: round;
  }

  /* Papier découpé : nappes d’eau pleines, sans trait ; ombres décalées. */
  .zone-map[data-preset='c'] .water path {
    stroke: none;
  }

  .zone-map[data-preset='c'] .water path:nth-child(1) {
    fill: var(--carte-eau-loin);
  }

  .zone-map[data-preset='c'] .water path:nth-child(2) {
    fill: var(--carte-eau-milieu);
  }

  .zone-map[data-preset='c'] .water path:nth-child(3) {
    fill: var(--carte-eau-pres);
  }

  .zone-map[data-preset='c'] .land-shadow {
    display: inline;
    fill: var(--carte-ombre);
    transform: translate(4px, 5px);
  }

  .zone-map[data-preset='c'] .zone {
    stroke: none;
  }

  .zone-map[data-preset='c'] .zone-shadow {
    display: inline;
    fill: var(--carte-zone-bord);
    transform: translate(3px, 4px);
  }

  .zone-map[data-preset='c'] .coast {
    display: none;
  }

  /* Noms : vrai texte, avec un liseré de la couleur du fond pour rester lisible. */
  .zone-map__svg text {
    fill: var(--text);
    stroke: var(--surface);
    stroke-linejoin: round;
    paint-order: stroke;
  }

  .city-labels text {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: calc(0.9375rem * var(--k));
    letter-spacing: var(--tracking-ui);
    stroke-width: calc(0.25rem * var(--k));
  }

  .cities circle {
    r: calc(0.28rem * var(--k));
    fill: var(--carte-point);
    stroke: var(--carte-point-bord);
    stroke-width: calc(0.125rem * var(--k));
  }

  .sea-label,
  .scale text {
    fill: var(--text-muted);
    font-family: var(--font-ui);
    font-size: calc(0.75rem * var(--k));
    stroke-width: calc(0.2rem * var(--k));
  }

  .sea-label {
    text-transform: uppercase;
    letter-spacing: 0.25em;
  }

  .scale path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: calc(0.125rem * var(--k));
  }

  .zone-map__caption {
    margin-block-start: var(--space-s);
    max-inline-size: var(--measure);
  }

  .zone-map__nowrap,
  .zone-map__cities li {
    white-space: nowrap;
  }

  .zone-map__legend {
    margin-block-start: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .zone-map__cities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    color: var(--text);
  }

  /* Pastilles posées sur la ligne de base : alignées sur la première ligne du texte. */
  .zone-map__cities li,
  .zone-map__note {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .zone-map__note,
  .zone-map__credit {
    margin-block: var(--space-2xs) 0;
  }

  .zone-map__key {
    flex: none;
    display: inline-block;
  }

  .zone-map__key--city {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    /* Forme sans texte : aucune couleur de texte à contrôler (npm run contrast). */
    color: transparent;
    background-color: var(--carte-point);
    box-shadow: 0 0 0 0.125rem var(--carte-point-bord);
  }

  /* Pastille de la zone : même aplat et même bord que sur la carte. */
  .zone-map__key--zone {
    inline-size: 1.25rem;
    block-size: 0.75rem;
    border-radius: 0.375rem;
    /* Forme sans texte : aucune couleur de texte à contrôler (npm run contrast). */
    color: transparent;
    background-color: var(--carte-zone);
    border: 0.09rem dashed var(--carte-zone-bord);
  }

  .zone-map[data-preset='b'] .zone-map__key--zone {
    border-style: solid;
  }

  .zone-map[data-preset='c'] .zone-map__key--zone {
    border: none;
    box-shadow: 0.15rem 0.2rem 0 var(--carte-zone-bord);
  }
</style>
