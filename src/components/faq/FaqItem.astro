---
/**
 * Une question de la FAQ, qui se déplie pour montrer sa réponse.
 *
 * Éléments natifs <details> et <summary> : ils s'ouvrent à la souris, au
 * doigt et au clavier (Tab pour atteindre la question, Entrée ou Espace pour
 * l'ouvrir), et les lecteurs d'écran annoncent leur état (réduit ou
 * développé). Sans JavaScript, tout fonctionne.
 *
 * Exemple :
 *   <FaqItem id="abonnement" question="Faut-il un abonnement ?">
 *     <p>Réponse…</p>
 *   </FaqItem>
 */
import Prose from '../texte/Prose.astro';

interface Props {
  /** Identifiant unique : le lien /faq/#<id> ouvre directement cette question. */
  id: string;
  question: string;
}

const { id, question } = Astro.props;
---

<details class="faq-item" id={id}>
  <summary class="faq-item__summary">
    <span class="faq-item__question">{question}</span>
    <span class="faq-item__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M5 12h14"></path>
        <path class="faq-item__bar" d="M12 5v14"></path>
      </svg>
    </span>
  </summary>
  <div class="faq-item__answer">
    <Prose>
      <slot />
    </Prose>
  </div>
</details>

<script>
  /*
   * Un lien vers une question (par exemple /faq/#abonnement) l'ouvre
   * directement, à l'arrivée sur la page comme après un clic sur un lien
   * interne. Sans JavaScript, le lien mène à la question, fermée.
   */
  function openLinkedQuestion(): void {
    let id: string;
    try {
      id = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    if (!id) return;
    const details = document.getElementById(id)?.closest('details');
    if (details && !details.open) details.open = true;
  }

  openLinkedQuestion();
  window.addEventListener('hashchange', openLinkedQuestion);
</script>

<style>
  .faq-item {
    border-block-end: var(--rule-width) solid var(--line);
  }

  .faq-item__summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: var(--target-min);
    padding-block: var(--space-m);
    border-radius: var(--radius-s);
    list-style: none;
    cursor: pointer;
  }

  /* Triangle par défaut du navigateur : remplacé par le signe « + ». */
  .faq-item__summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__summary::marker {
    content: '';
  }

  .faq-item__question {
    flex: 1 1 auto;
    min-width: 0;
    padding-block-start: 0.2rem;
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-variation);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: var(--leading-snug);
    color: var(--text);
    text-wrap: pretty;
    text-decoration-line: underline;
    text-decoration-thickness: max(1px, 0.06em);
    text-underline-offset: 0.22em;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }

  .faq-item__summary:hover .faq-item__question {
    text-decoration-color: currentColor;
  }

  .faq-item__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--rule-width) solid var(--line-strong);
    border-radius: 50%;
    color: var(--text);
    transition:
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  .faq-item__summary:hover .faq-item__icon {
    border-color: var(--text);
  }

  .faq-item__icon svg {
    display: block;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  /* Ouvert, la barre verticale pivote et se couche : le « + » devient « − ». */
  .faq-item__bar {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .faq-item[open] .faq-item__bar {
    transform: rotate(90deg);
  }

  .faq-item__answer {
    padding-block-end: var(--space-l);
    padding-inline-end: calc(2.25rem + var(--space-m));
  }

  .faq-item[open] .faq-item__answer {
    animation: faq-item-reveal var(--dur-3) var(--ease-out);
  }

  @keyframes faq-item-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.375rem);
    }
  }

  @media (max-width: 30rem) {
    .faq-item__answer {
      padding-inline-end: 0;
    }
  }
</style>
