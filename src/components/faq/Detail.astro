---
/**
 * Information tirée des fichiers de données (src/data/tarifs.ts,
 * src/data/entreprise.ts et src/data/faits.ts), à écrire dans un texte MDX
 * sans la recopier :
 *
 *   <Detail of="security-updates" />   durée des mises à jour de sécurité de Hako Home
 *   <Detail of="pro-commitment" />     durée d'engagement de l'abonnement de Hako Pro
 *   <Detail of="pro-response-time" />  délai de réponse garanti de Hako Pro
 *   <Detail of="included-storage" />   stockage inclus (« 1 To »)
 *   <Detail of="storage-options" />    stockages proposés en option (« 2 To ou 4 To »)
 *   <Detail of="mover-offers" />       offres qui comprennent le déménageur (« Hako Home et Hako Pro »)
 *   <Detail of="remote-access" />      accès depuis l’extérieur : pas prévu, choix de sécurité
 *   <Detail of="pro-maintenance" />    maintenance à distance de Hako Pro : tunnel WireGuard, sur demande
 *   <Detail of="payment" />            paiement : par virement, pas encore en ligne (phrase)
 *   <Detail of="pro-subscription-payment" /> abonnement de Hako Pro : chaque mois, par virement (phrase)
 *   <Detail of="warranty" />           garantie d'un an, en plus de la garantie légale (phrase)
 *   <Detail of="warranty-terms" />     ce que couvre la garantie, et comment la faire jouer
 *   <Detail of="service-area" />       phrase sur la zone d'intervention
 *   <Detail of="outside-area" />       ce que nous proposons hors de cette zone
 *   <Detail of="email" />              adresse e-mail de contact (lien)
 *   <Detail of="phone" />              numéro de téléphone (lien)
 *   <Detail of="box-address" />        adresse de la page de la HAKO (http://hako.local), à taper
 *   <Detail of="android-version" />    version d’Android à partir de laquelle cette adresse s’ouvre
 *
 * Une information encore inconnue s'affiche en repère jaune, avec le même
 * texte que sur les autres pages (pour les tarifs : missingPrice, dans
 * src/data/faits.ts). Elle est recensée une seule fois dans TODO.md, depuis
 * le fichier de données. Les deux dernières valeurs viennent de
 * src/data/installation.ts, où l'adresse de la HAKO s'écrit une seule fois.
 */
import Fact from '../Fact.astro';
import Text from '../texte/Text.astro';
import Todo from '../Todo.astro';
import { company } from '../../data/entreprise';
import {
  missingPrice,
  moverOffers,
  payment,
  proMaintenance,
  proSubscriptionPayment,
  remoteAccess,
  warranty,
} from '../../data/faits';
import { boxAddress, requirements } from '../../data/installation';
import { pricing } from '../../data/tarifs';
import { orMissing } from '../../lib/commande/inline';
import { formatList } from '../../lib/format';
import { isTodo, type Maybe } from '../../lib/todo';

export type DetailId =
  | 'security-updates'
  | 'pro-commitment'
  | 'pro-response-time'
  | 'included-storage'
  | 'storage-options'
  | 'mover-offers'
  | 'remote-access'
  | 'pro-maintenance'
  | 'payment'
  | 'pro-subscription-payment'
  | 'warranty'
  | 'warranty-terms'
  | 'service-area'
  | 'outside-area'
  | 'email'
  | 'phone'
  | 'box-address'
  | 'android-version';

interface Props {
  of: DetailId;
}

const { of: id } = Astro.props;

const { home, pro } = pricing.offers;
const included = pricing.storage.find((option) => option.id === pricing.includedStorage);
if (!included) {
  throw new Error('FAQ : le stockage inclus (includedStorage) est absent de src/data/tarifs.ts.');
}
const options = pricing.storage
  .filter((option) => option.id !== pricing.includedStorage)
  .map((option) => option.label);

const values: Record<DetailId, Maybe<string>> = {
  'security-updates': orMissing(home.securityUpdates, missingPrice.securityUpdates(home)),
  'pro-commitment': orMissing(pro.subscription?.commitment, missingPrice.commitment(pro)),
  'pro-response-time': orMissing(pro.subscription?.responseTime, missingPrice.responseTime(pro)),
  'included-storage': included.label,
  'storage-options': formatList(options, 'or'),
  'mover-offers': moverOffers.names,
  'remote-access': remoteAccess.choice,
  'pro-maintenance': proMaintenance,
  payment,
  'pro-subscription-payment': proSubscriptionPayment,
  warranty: warranty.sentence,
  'warranty-terms': warranty.terms,
  'service-area': company.serviceArea.sentence,
  'outside-area': company.serviceArea.outside,
  email: company.email,
  phone: company.phone,
  'box-address': boxAddress.display,
  'android-version': requirements.android,
};

const value = values[id];
// E-mail et téléphone : un lien (« mailto: », « tel: »), écrit par <Fact>,
// jamais coupé en fin de ligne. Le reste est du texte courant, dont les noms
// composés (« Aix-en-Provence ») ne se coupent pas non plus (<Text>).
const link = id === 'email' || id === 'phone' ? id : undefined;
---

{isTodo(value) ? (
  <Todo what={value.todo}>{value.placeholder}</Todo>
) : id === 'box-address' ? (
  <code translate="no">{value}</code>
) : link ? (
  <span class="nowrap">
    <Fact value={value} link={link} />
  </span>
) : (
  <Text text={value} />
)}
