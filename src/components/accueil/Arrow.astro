---
/**
 * Petite flèche décorative, après le texte d’un lien (« Lire la suite → »).
 * Même dessin que l’icône arrow-right du site : trait de 1,5 sur une grille de 24.
 */
---

<svg
  class="arrow"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M4 12h16"></path>
  <path d="m14 6 6 6-6 6"></path>
</svg>

<style>
  .arrow {
    display: inline-block;
    flex: none;
    inline-size: 1.15em;
    block-size: 1.15em;
    vertical-align: -0.2em;
    transition: transform var(--dur-2) var(--ease-out);
  }

  :global(a:hover) > .arrow,
  :global(a:focus-visible) > .arrow {
    transform: translateX(0.2em);
  }
</style>
