---
/**
 * a. Ouverture de l’accueil : accroche (h1), promesse, deux boutons et quatre
 * repères. Le texte vient en premier dans la page : il s’affiche tout de suite,
 * sans attendre d’image. Le kanji du logo est un SVG inséré dans la page,
 * posé sur une « boîte » dessinée en CSS (le filet du couvercle, comme sur
 * le vrai boîtier). Sous la boîte, la phrase qui explique le nom, la même
 * que sur la page Notre engagement (nameSentence, src/data/faits.ts).
 */
import Logo from '../Logo.astro';
import RichText from './RichText.astro';
import { hero } from '../../content/accueil';
import { company } from '../../data/entreprise';
import { nameSentence } from '../../data/faits';
---

<section class="hero" aria-labelledby="titre-accueil">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="kicker hero__kicker">{hero.kicker}</p>
      <h1 id="titre-accueil" class="hero__title">
        <RichText text={company.headline} />
      </h1>
      <p class="hero__promise">
        <RichText text={company.promise} />
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary hero__btn" href={hero.primary.href}>
          {hero.primary.label}
        </a>
        <a class="btn btn--secondary hero__btn" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>
      <ul class="hero__highlights" aria-label={hero.highlightsLabel}>
        {hero.highlights.map((item) => (
          <li class="hero__highlight">
            <svg
              class="hero__check"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m5 12.5 4.5 4.5L19 7.5" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <figure class="hero-mark">
      <div class="hero-mark__box surface-sable">
        <Logo variant="kanji" label={hero.kanjiLabel} class="hero-mark__kanji" />
      </div>
      <figcaption class="hero-mark__caption">
        {
          // Une seule expression : aucune espace ne s'invite autour du kanji.
          [nameSentence.before, <span lang="ja">{nameSentence.kanji}</span>, nameSentence.after]
        }
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.25rem + 5vw, 6rem) var(--space-section);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  /* Le style du surtitre vient de la classe .kicker du site. */
  .hero__kicker {
    margin: 0;
    text-wrap: balance;
  }

  .hero__title {
    max-inline-size: 12ch;
    margin: var(--space-s) 0 0;
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 400;
    font-variation-settings: var(--font-display-variation);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero__promise {
    max-inline-size: 34ch;
    margin: var(--space-m) 0 0;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }

  /* Sur petit écran, les deux boutons se partagent la ligne. */
  .hero__btn {
    flex: 1 1 auto;
  }

  /* Deux colonnes dès qu'il y a la place, une seule sur les plus petits écrans. */
  .hero__highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-xs) var(--space-m);
    margin: var(--space-xl) 0 0;
    padding: var(--space-m) 0 0;
    list-style: none;
    border-block-start: var(--rule-width) solid var(--line);
  }

  .hero__highlight {
    display: flex;
    align-items: flex-start;
    gap: 0.45em;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: var(--tracking-ui);
  }

  .hero__check {
    flex: none;
    inline-size: 1.15em;
    block-size: 1.15em;
    color: var(--success);
  }

  .hero-mark {
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    margin: 0;
  }

  /* Une boîte vue de côté : coins arrondis, ombre chaude, filet du couvercle. */
  .hero-mark__box {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    border-radius: calc(var(--radius) * 2);
    box-shadow:
      var(--shadow-l),
      inset 0 0 0 var(--rule-width) var(--line);
  }

  .hero-mark__box::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 22%;
    border-block-start: var(--rule-width) solid var(--line-strong);
    opacity: 0.3;
  }

  .hero-mark :global(.hero-mark__kanji) {
    inline-size: 19%;
    block-size: auto;
    color: var(--text);
  }

  .hero-mark__caption {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    line-height: 1.4;
    letter-spacing: var(--tracking-ui);
    text-align: center;
    color: var(--text-muted);
  }

  @media (min-width: 30rem) {
    .hero__btn {
      flex: 0 0 auto;
    }
  }

  @media (min-width: 40rem) {
    /* Deux colonnes à la largeur de leur texte, sans jamais dépasser la
       colonne de l'accroche : un repère trop long passe à la ligne. */
    .hero__highlights {
      grid-template-columns: repeat(2, minmax(0, max-content));
      gap: var(--space-xs) var(--space-xl);
    }

    .hero__highlight {
      text-wrap: balance;
    }

    /* Tablette : la boîte, plus petite, et sa légende à côté. */
    .hero-mark {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: var(--space-l);
      align-items: center;
      justify-items: start;
    }

    .hero-mark__caption {
      max-inline-size: 22ch;
      font-size: var(--step-0);
      text-align: start;
    }
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    .hero-mark {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-s);
      justify-items: center;
    }

    .hero-mark__caption {
      max-inline-size: none;
      font-size: var(--step--1);
      text-align: center;
    }

    .hero-mark__box {
      aspect-ratio: 1 / 1;
    }

    .hero-mark :global(.hero-mark__kanji) {
      inline-size: 28%;
    }
  }
</style>
