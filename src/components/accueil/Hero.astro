---
/**
 * a. Ouverture de l’accueil : accroche (h1), promesse, deux boutons, une ligne
 * vers le guide d’installation, qui servira bientôt hors de notre zone, et quatre
 * repères. Le texte vient en premier dans la page : il s’affiche tout de suite,
 * sans attendre d’image. À côté (dessous sur téléphone), la box vue de trois
 * quarts, en image de synthèse du prototype, sur le fond « pierre » de ses
 * rendus (PrototypeFigure). C’est la seule image chargée en priorité. Sa
 * légende reprend la phrase qui explique le nom (src/content/prototype.ts).
 */
import PrototypeFigure from '../prototype/PrototypeFigure.astro';
import Text from '../texte/Text.astro';
import TextLink from '../texte/TextLink.astro';
import RichText from './RichText.astro';
import { hero } from '../../content/accueil';
import { prototype } from '../../content/prototype';
import { company } from '../../data/entreprise';
---

<section class="hero" aria-labelledby="titre-accueil">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="kicker hero__kicker">{hero.kicker}</p>
      <h1 id="titre-accueil" class="hero__title">
        <RichText text={company.headline} />
      </h1>
      <p class="hero__promise">
        <RichText text={company.promise} />
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary hero__btn" href={hero.primary.href}>
          {hero.primary.label}
        </a>
        <a class="btn btn--secondary hero__btn" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>
      <p class="hero__received">
        <Text text={hero.received.text} /> <TextLink link={hero.received.link} arrow />
      </p>
      <ul class="hero__highlights" aria-label={hero.highlightsLabel}>
        {hero.highlights.map((item) => (
          <li class="hero__highlight">
            <svg
              class="hero__check"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d="m5 12.5 4.5 4.5L19 7.5" />
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <PrototypeFigure
      view={prototype.hero.view}
      alt={prototype.hero.alt}
      caption={prototype.hero.caption}
      sizes="(min-width: 77rem) 29rem, (min-width: 60rem) calc(38.8vw - 0.5rem), (min-width: 40rem) 36rem, calc(95.2vw - 1.2rem)"
      priority
      float
      class="hero-visual"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.25rem + 5vw, 6rem) var(--space-section);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  /* Le style du surtitre vient de la classe .kicker du site. */
  .hero__kicker {
    margin: 0;
    text-wrap: balance;
  }

  .hero__title {
    max-inline-size: 12ch;
    margin: var(--space-s) 0 0;
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 400;
    font-variation-settings: var(--font-display-variation);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero__promise {
    max-inline-size: 34ch;
    margin: var(--space-m) 0 0;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
  }

  /* Le guide d’installation, pour bientôt : une ligne sous les boutons, avec le
     lien « pour aller plus loin » du site (TextLink), comme sur la page
     Tutoriels. */
  .hero__received {
    margin: var(--space-s) 0 0;
    color: var(--text-muted);
  }

  /* Sur petit écran, les deux boutons se partagent la ligne. */
  .hero__btn {
    flex: 1 1 auto;
  }

  /* Deux colonnes dès qu'il y a la place, une seule sur les plus petits écrans. */
  .hero__highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-xs) var(--space-m);
    margin: var(--space-xl) 0 0;
    padding: var(--space-m) 0 0;
    list-style: none;
    border-block-start: var(--rule-width) solid var(--line);
  }

  .hero__highlight {
    display: flex;
    align-items: flex-start;
    gap: 0.45em;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: var(--tracking-ui);
  }

  .hero__check {
    flex: none;
    inline-size: 1.15em;
    block-size: 1.15em;
    color: var(--success);
  }

  @media (min-width: 30rem) {
    .hero__btn {
      flex: 0 0 auto;
    }
  }

  @media (min-width: 40rem) {
    /* Deux colonnes à la largeur de leur texte, sans jamais dépasser la
       colonne de l'accroche : un repère trop long passe à la ligne. */
    .hero__highlights {
      grid-template-columns: repeat(2, minmax(0, max-content));
      gap: var(--space-xs) var(--space-xl);
    }

    .hero__highlight {
      text-wrap: balance;
    }

    /* Tablette : l'image reste sous le texte, sans dépasser 36rem de large,
       centrée (sinon un quart vide à droite). Plus large, elle remplit sa
       colonne : le centrage n'y change rien. */
    .hero__grid :global(.hero-visual) {
      inline-size: min(100%, 36rem);
      justify-self: center;
    }
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    /* Grand écran : à côté du texte, un panneau carré, la box au milieu.
       Si la grille change, recalculez l'attribut sizes de l'image. */
    .hero__grid :global(.hero-visual) {
      --prototype-panel-ratio: 1;

      inline-size: 100%;
    }
  }
</style>
