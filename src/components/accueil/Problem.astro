---
/**
 * b. Le constat (calme, sans faire peur), un seul fait d’actualité avec sa
 * source, puis le déménageur : comment vos photos reviennent à la maison.
 */
import Illustration from '../Illustration.astro';
import Kicker from './Kicker.astro';
import RichText from './RichText.astro';
import SectionHeader from './SectionHeader.astro';
import './rules.css';
import { mover, problem } from '../../content/accueil';
---

<section class="problem surface-sable" aria-labelledby="titre-constat">
  <div class="container">
    <div class="problem__grid">
      <div class="problem__text">
        <SectionHeader
          id="titre-constat"
          kicker={problem.kicker}
          title={problem.title}
          intro={problem.intro}
        />
        <ul class="problem__points">
          {problem.points.map((point) => (
            <li class="problem__point">
              <RichText text={point} />
            </li>
          ))}
        </ul>
      </div>
      <div class="problem__visual">
        <Illustration name="probleme" ratio="4/3" alt={problem.illustrationAlt} />
      </div>
    </div>

    <div class="problem__example">
      <p class="problem__example-text">
        <RichText text={problem.example.text} />
      </p>
      <p class="problem__source">
        {problem.example.sourceLead}{' '}
        <a
          href={problem.example.source.href}
          hreflang={problem.example.source.hreflang}
          rel="noreferrer"
        >
          {problem.example.source.label}
        </a>
      </p>
    </div>

    <p class="problem__closing">
      <RichText text={problem.closing} />
    </p>

    <div class="mover surface-creme">
      <div class="mover__visual">
        <Illustration name="demenageur" ratio="4/3" alt={mover.illustrationAlt} />
      </div>
      <div class="mover__text">
        <Kicker text={mover.kicker} />
        <h3 class="mover__title">
          <RichText text={mover.title} />
        </h3>
        <p class="mover__paragraph">
          <RichText text={mover.text} />
        </p>
        <p class="mover__paragraph">
          <RichText text={mover.privacy} />
        </p>
        <p class="mover__included">
          <svg
            class="mover__check"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="m5 12.5 4.5 4.5L19 7.5"></path>
          </svg>
          <span>
            <RichText text={mover.included} />
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .problem {
    padding-block: var(--space-section);
  }

  .problem__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .problem__points {
    max-inline-size: 46ch;
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    border-block-end: var(--rule-width) solid var(--rule-soft);
  }

  .problem__point {
    position: relative;
    padding-block: var(--space-s);
    padding-inline-start: 1.6em;
    border-block-start: var(--rule-width) solid var(--rule-soft);
    text-wrap: pretty;
  }

  /* Petit carré, comme le surtitre : la boîte, en filigrane. */
  .problem__point::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.1em;
    inset-block-start: calc(var(--space-s) + 0.55em);
    inline-size: 0.5em;
    block-size: 0.5em;
    /* Forme sans texte : aucune couleur de texte à contrôler (npm run contrast). */
    color: transparent;
    background-color: var(--link);
    border-radius: 1px;
  }

  .problem__visual {
    inline-size: 100%;
    max-inline-size: 36rem;
    justify-self: center;
  }

  .problem__example {
    display: grid;
    gap: var(--space-xs);
    max-inline-size: 62ch;
    margin-block-start: var(--space-2xl);
    padding-inline-start: var(--space-m);
    border-inline-start: 2px solid var(--link);
  }

  .problem__example-text {
    margin: 0;
    text-wrap: pretty;
  }

  .problem__source {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-ui);
    color: var(--text-muted);
  }

  /* Lien seul sur sa ligne : une cible confortable au doigt. */
  .problem__source a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
  }

  .problem__closing {
    max-inline-size: 26ch;
    margin: var(--space-2xl) 0 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    font-variation-settings: var(--font-display-variation);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .mover {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    margin-block-start: var(--space-xl);
    padding: var(--space-m);
    border-radius: calc(var(--radius) * 1.5);
    box-shadow: var(--shadow-m);
  }

  .mover__text {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .mover__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    font-variation-settings: var(--font-display-variation);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .mover__paragraph {
    max-inline-size: 52ch;
    margin: 0;
    text-wrap: pretty;
  }

  /* Même coche que les repères de l’ouverture et les listes des offres. */
  .mover__included {
    display: flex;
    align-items: flex-start;
    gap: 0.45em;
    margin: var(--space-2xs) 0 0;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: var(--tracking-ui);
  }

  .mover__check {
    flex: none;
    inline-size: 1.15em;
    block-size: 1.15em;
    color: var(--success);
  }

  @media (min-width: 48rem) {
    .mover {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-xl);
      padding: var(--space-l);
    }
  }

  @media (min-width: 60rem) {
    .problem__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }
</style>
