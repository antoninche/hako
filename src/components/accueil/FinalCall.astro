---
/**
 * h. Dernier appel : commander, ou poser d’abord une question.
 * Au-dessus du titre, le kanji du logo, comme un sceau (décoratif).
 */
import Logo from '../Logo.astro';
import Arrow from './Arrow.astro';
import RichText from './RichText.astro';
import { finalCall } from '../../content/accueil';
---

<section class="final surface-sable" aria-labelledby="titre-appel">
  <div class="container final__inner">
    <Logo variant="kanji" decorative class="final__mark" />
    <h2 id="titre-appel" class="final__title">
      <RichText text={finalCall.title} />
    </h2>
    <p class="final__text">
      <RichText text={finalCall.text} />
    </p>
    <div class="final__actions">
      <a class="btn btn--primary" href={finalCall.primary.href}>
        {finalCall.primary.label}
      </a>
      <a class="btn btn--secondary" href={finalCall.secondary.href}>
        {finalCall.secondary.label}
      </a>
    </div>
    <a class="final__faq" href={finalCall.faq.href}>
      {finalCall.faq.label}
      <Arrow />
    </a>
  </div>
</section>

<style>
  .final {
    padding-block: var(--space-section);
  }

  .final__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  /* Une boîte en miniature : contour fin et filet du couvercle. */
  .final__inner :global(.final__mark) {
    inline-size: 2.75rem;
    block-size: auto;
    color: var(--text);
  }

  .final__title {
    max-inline-size: 18ch;
    margin: var(--space-l) 0 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 400;
    font-variation-settings: var(--font-display-variation);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .final__text {
    max-inline-size: 44ch;
    margin: var(--space-m) 0 0;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* Deux boutons de même largeur, côte à côte ou l'un sous l'autre. */
  .final__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    inline-size: min(100%, 32rem);
    margin-block-start: var(--space-xl);
  }

  .final__actions > :global(.btn) {
    flex: 1 1 13rem;
  }

  .final__faq {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: var(--target-min);
    margin-block-start: var(--space-m);
    font-family: var(--font-ui);
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
  }
</style>
