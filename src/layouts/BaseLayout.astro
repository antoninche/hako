---
/**
 * Gabarit commun à toutes les pages : <head>, lien d'évitement, en-tête,
 * contenu principal et pied de page.
 *
 * Exemple :
 *   <BaseLayout title="Nos offres" description="Ce que comprend chaque offre.">
 *     …contenu de la page…
 *   </BaseLayout>
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

import { PUBLIC_SHOW_TODOS } from 'astro:env/client';
import Footer from '../components/Footer.astro';
import FontPreloads from '../components/FontPreloads.astro';
import Header from '../components/Header.astro';
import { company } from '../data/entreprise';
import { frenchTypography } from '../lib/typography';

interface Props {
  /** Titre de la page, sans le nom du site. Sans titre : page d'accueil. */
  title?: string;
  /** Résumé affiché par les moteurs de recherche (150 caractères environ). */
  description: string;
  /** true : la page ne doit pas être indexée (charte interne, page 404). */
  noindex?: boolean;
  /** Fond de la page : crème par défaut. */
  surface?: 'creme' | 'sable' | 'chocolat';
}

const { title, description, noindex = false, surface = 'creme' } = Astro.props;

// « Page · HAKO » ; l'accueil reprend l'accroche : « HAKO · Vos souvenirs… ».
const fullTitle = title
  ? `${title} · ${company.name}`
  : `${company.name} · ${company.headline.replace(/\.$/, '')}`;

// Adresse canonique : seulement si SITE_URL est connue (voir astro.config.mjs).
const canonical = !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;

// Aperçu d'un lien partagé (réseaux sociaux, messageries) : balises Open Graph.
// L'image doit avoir une adresse complète : seulement si SITE_URL est connue.
// public/og/hako-og.png mesure 1200 × 630 px (tests/builds.spec.ts le vérifie).
const shareImage = Astro.site ? new URL('/og/hako-og.png', Astro.site) : undefined;
const shareImageAlt = frenchTypography(
  'Le logo de HAKO : le kanji 箱, « boîte » en japonais, au-dessus du mot HAKO.',
);
---

<!doctype html>
<html lang="fr" data-todos={PUBLIC_SHOW_TODOS ? 'visible' : 'discreet'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Même règle que l'en-tête Referrer-Policy de scripts/serve-prod.mjs, pour
        les hébergeurs qui n'envoient pas d'en-têtes (GitHub Pages). */}
    <meta name="referrer" content="same-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && (
      <>
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={shareImageAlt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <FontPreloads />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FDF7EF" />
    {/* Balises propres à une page, par exemple une règle de sécurité plus
        stricte (src/pages/installer/demonstration/index.astro). */}
    <slot name="head" />
  </head>
  <body class={`surface-${surface}`}>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
