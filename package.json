{
  "name": "hako-site",
  "version": "0.1.0",
  "private": true,
  "description": "Site de HAKO, la box qui garde les photos et les fichiers de la famille à la maison.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "todos": "node scripts/todos.mjs",
    "contrast": "node scripts/contrast.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "playwright test",
    "screenshots": "playwright test --grep @captures",
    "fonts:build": "sh scripts/fonts/build.sh",
    "logo:build": "node scripts/logo/build.mjs"
  },
  "dependencies": {
    "astro": "7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "allowScripts": {
    "fsevents": false
  }
}
