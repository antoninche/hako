{
  "name": "hako-site",
  "version": "0.3.0",
  "private": true,
  "description": "Site de HAKO, la box qui garde les photos et les fichiers de la famille à la maison.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check && eslint . && prettier --check . && node scripts/model/check.mjs",
    "format": "prettier --write .",
    "todos": "node scripts/todos.mjs",
    "contrast": "node scripts/contrast.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test:unit": "node --test tests/unit/",
    "test": "npm run test:unit && playwright test",
    "screenshots": "playwright test --grep @captures",
    "test:csp": "playwright test tests/csp.spec.ts",
    "fonts:build": "sh scripts/fonts/build.sh",
    "logo:build": "node scripts/logo/build.mjs",
    "serve:prod": "node scripts/serve-prod.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "model:check": "node scripts/model/check.mjs",
    "model:optimize": "node scripts/model/optimize.mjs",
    "model:test-glb": "node scripts/model/make-test-glb.mjs",
    "model:fallback": "node scripts/model/capture-fallback.mjs",
    "map:build": "node scripts/map/build.mjs",
    "illustrations:build": "node design/illustrations/_source/dessins.mjs && node design/illustrations/_source/installation.mjs && svgo --config design/illustrations/svgo.config.mjs --quiet -r -f src/assets/illustrations",
    "illustrations:check": "node scripts/illustrations/check.mjs",
    "illustrations:render": "node scripts/illustrations/render.mjs",
    "prototype:images": "node scripts/prototype/prepare.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.5",
    "astro": "7.4.11",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "chrome-launcher": "1.2.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "meshoptimizer": "1.3.0",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "allowScripts": {
    "fsevents": false
  }
}
