# Versions figées de HakOS, toutes dans ce seul fichier.
# Format CLÉ=valeur, sans guillemets ni espaces, lisible par bash et par docker compose.
# Aucune étiquette « latest » ou « release ».
#
# Ce fichier est copié dans l'image (/opt/box/versions.env). Au premier démarrage, ses lignes
# CLÉ=valeur ouvrent le fichier .env de chaque application : les fichiers docker-compose.yml
# y lisent les noms des images. Les images sont livrées dans l'image système, en archives
# préparées par scripts/recuperer-images.sh : rien n'est téléchargé chez le client.

# Base du système : pi-gen (Raspberry Pi), branche arm64, révision figée.
PIGEN_DEPOT=https://github.com/RPi-Distro/pi-gen.git
PIGEN_BRANCHE=arm64
PIGEN_COMMIT=c0d2c9f2cffc08bc56850b0a3eb23178f4226e8a

# Immich (photos) : version des images immich-server et immich-machine-learning,
# ghcr.io/immich-app/immich-server:<version> et ghcr.io/immich-app/immich-machine-learning:<version>.
IMMICH_VERSION=v3.4.1

# Valkey et Postgres d'Immich : étiquette et empreinte reprises du docker-compose.yml officiel
# de la v3.4.1. L'empreinte fige le contenu ; l'image est livrée sous son étiquette.
IMMICH_VALKEY_IMAGE=docker.io/valkey/valkey:9
IMMICH_VALKEY_DIGEST=sha256:418652cfb58ef879d4978c33553735d7147016032d5aefaa14c828e611eb9dfd
IMMICH_POSTGRES_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
IMMICH_POSTGRES_DIGEST=sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

# Nextcloud (fichiers) et sa base de données.
NEXTCLOUD_IMAGE=nextcloud:34.0.5-apache
NEXTCLOUD_POSTGRES_IMAGE=postgres:17.12-alpine

# Page d'accueil (http://hako.local).
NGINX_IMAGE=nginx:1.31.8-alpine

# Page de la HAKO (première installation), servie sur le port 80 avant l'installation :
# construite depuis le dépôt hako-site à ce commit, par
#   npm ci && SITE_URL=https://hako-box.github.io npm run build:box
# puis dist-box/ copié dans rootfs/opt/box/home/assistant/. Pour la changer : reconstruire à un
# autre commit, recopier, et changer cette ligne.
HAKO_SITE_COMMIT=0e22b688155045505bacc423cf8094d76c1bd317
HAKO_SITE_URL=https://hako-box.github.io
