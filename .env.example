# Copier ce fichier en .env pour changer le comportement local.

# true (par défaut) : les informations manquantes sont surlignées en jaune.
# false : le texte provisoire reste, sans surlignage (pour une démonstration).
PUBLIC_SHOW_TODOS=true

# Adresse publique du site, utilisée pour écrire l'adresse complète des pages
# (lien canonique). Sans elle, les pages ne déclarent aucune adresse canonique.
# SITE_URL=https://exemple.fr
