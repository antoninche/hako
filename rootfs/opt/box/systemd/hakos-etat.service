# HakOS : état de la box pour la page d'accueil (/opt/box/etat/etat.py), lancé chaque minute par
# hakos-etat.timer. Écrit /run/hakos-etat/etat.json, sans aucun secret, que le nginx de l'accueil
# sert à http://hako.local/api/etat.
# En root pour docker exec (nombre de photos dans la base d'Immich) et vcgencmd (température) ;
# aucun accès au réseau. Installé dans /etc/systemd/system par stage-box/03.

[Unit]
Description=HakOS : état de la box pour la page d'accueil
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B -E -s /opt/box/etat/etat.py
TimeoutStartSec=50s
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/hakos-etat
ProtectHome=tmpfs
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitCORE=0
StandardOutput=journal
StandardError=journal
