# HakOS : noms des applications sur le réseau de la maison (/opt/box/noms/noms.py).
# Annonce par avahi hako-photos.local et hako-fichiers.local (hako-2-photos.local… pour une
# deuxième box), à l'adresse IPv4 de la box, et tient à jour cette adresse parmi les domaines de
# confiance de Nextcloud (adresse de secours http://<adresse IP>:8080).
# En root pour docker exec (occ de Nextcloud) ; le durcissement protège des accidents.
# Journal : journalctl -u hakos-noms. Installé dans /etc/systemd/system par stage-box/03.

[Unit]
Description=HakOS : noms des applications (hako-photos.local, hako-fichiers.local)
After=avahi-daemon.service network-online.target docker.service
Wants=avahi-daemon.service network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B -E -s /opt/box/noms/noms.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
